lemma auto_token_integrity [reuse]:
  all-traces
  "∀ AGGR OTEE #i.
    (AcceptVerification( AGGR, OTEE ) @ #i) ⇒
    (∃ D NP #j. (OTEERegisteredOnDevice( NP, OTEE, D ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ AGGR OTEE #i.
  (AcceptVerification( AGGR, OTEE ) @ #i)
 ∧
  ∀ D NP #j. (OTEERegisteredOnDevice( NP, OTEE, D ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( !NP_Pk( $NP, pk(x) ) ▶₂ #i )
  case NP_Init
  solve( !KU( sign(<$otee_id, pk(~OTEE)>, ~ltk.1) ) @ #vk.6 )
    case NP_Register_OTEE_On_Device
    by contradiction /* from formulas */
  next
    case c_sign
    by contradiction /* from formulas */
  qed
qed

lemma auto_measurementPositionIsUnique [reuse]:
  all-traces
  "∀ OTEE OTEE2 pos #i #j.
    (((OTEEPosition( OTEE, pos ) @ #i) ∧ (OTEEPosition( OTEE2, pos ) @ #j)) ∧
     (¬(#i = #j))) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ OTEE OTEE2 pos #i #j.
  (OTEEPosition( OTEE, pos ) @ #i) ∧ (OTEEPosition( OTEE2, pos ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
solve( OTEE_2( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1,
               X_11, DHE, srv_pk
       ) ▶₀ #i )
  case OTEE_Receive_Server_Hello
  solve( OTEE_2( ~tee_id.1, $OTEE.1, 'g', 'g2', $D.1, ~u.1, n_0, ~x_0.1,
                 X_00, n_1, X_11, 'g'^(~x*~x.1), srv_pk
         ) ▶₀ #j )
    case OTEE_Receive_Server_Hello_case_1
    by contradiction /* from formulas */
  next
    case OTEE_Receive_Server_Hello_case_2
    by contradiction /* from formulas */
  qed
qed

lemma auto_succeessfultVerificationImpliesEnclaveMeasuredCorrectProperties [reuse]:
  all-traces
  "∀ AGGR OTEE A prop pos #i #j.
    (((AcceptVerificationWithAgent( AGGR, OTEE, A, prop ) @ #i) ∧
      (AcceptVerificationPosition( AGGR, pos ) @ #i)) ∧
     (OTEEPosition( OTEE, pos ) @ #j)) ⇒
    (∃ D. OTEEHonestPropertyRead( OTEE, D, A, prop ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ AGGR OTEE A prop pos #i #j.
  (AcceptVerificationWithAgent( AGGR, OTEE, A, prop ) @ #i) ∧
  (AcceptVerificationPosition( AGGR, pos ) @ #i) ∧
  (OTEEPosition( OTEE, pos ) @ #j)
 ∧
  ∀ D. (OTEEHonestPropertyRead( OTEE, D, A, prop ) @ #j) ⇒ ⊥"
*/
simplify
solve( !NP_Pk( $NP, pk(x) ) ▶₂ #i )
  case NP_Init
  solve( !KU( sign(<$otee_id, pk(~OTEE)>, ~ltk.1) ) @ #vk.6 )
    case NP_Register_OTEE_On_Device
    solve( Aggressor_1( $AGGR, 'g', 'g2', ~prop, ~s, $A, ~ltk, n_0, X_00,
                        n_1, ~x_1, X_11, DHE
           ) ▶₀ #i )
      case Server_Hello
      solve( !KU( pk(~OTEE) ) @ #vk.6 )
        case NP_Register_OTEE_On_Device
        solve( splitEqs(0) )
          case split_case_1
          by contradiction /* from formulas */
        next
          case split_case_2
          by contradiction /* from formulas */
        next
          case split_case_3
          solve( OTEE_2( ~tee_id, $otee_id, 'g', 'g2', $D, ~u, n_0.1, ~x_0, X_00,
                         n_1, X_11, 'g'^(~x*~x_1), srv_pk
                 ) ▶₀ #j )
            case OTEE_Receive_Server_Hello_case_1
            solve( !KU( senc(hmac(derive_secret(derive_secret('g'^(~x*~x_1),
                                                              'c_hs_traffic'),
                                                'finished'),
                                  <<n_0, 'g'^~x, add('g2'^~s, z), 'g'^~x_1, pk(~ltk)>,
                                   h3(<n_0, 'g'^~x, add('g2'^~s, z), 'g'^~x_1, pk(~ltk)>)>),
                             derive_secret('g'^(~x*~x_1), 'c_hs_traffic'))
                   ) @ #vk.5 )
              case OTEE_Challenge_Response_case_1
              solve( !KU( senc(hmac(derive_secret(derive_secret('g'^(~x_0*~x_1),
                                                                's_hs_traffic'),
                                                  'finished'),
                                    <
                                     <'g2'^~u, 'g'^~x_0,
                                      add('g2'^~e1,
                                          'g2'^(~u*h2('0', measure(select('g'^(~x_0*~x_1)), ~prop)))),
                                      'g'^~x_1>,
                                     sign(<
                                           <'g2'^~u, 'g'^~x_0,
                                            add('g2'^~e1,
                                                'g2'^(~u*h2('0', measure(select('g'^(~x_0*~x_1)), ~prop)))),
                                            'g'^~x_1>,
                                           h3(<'g2'^~u, 'g'^~x_0,
                                               add('g2'^~e1,
                                                   'g2'^(~u*h2('0', measure(select('g'^(~x_0*~x_1)), ~prop))
                                                        )),
                                               'g'^~x_1>)
                                          >,
                                          ~ltk)
                                    >),
                               derive_secret('g'^(~x_0*~x_1), 's_hs_traffic'))
                     ) @ #vk.16 )
                case Server_Hello
                solve( !KU( senc(<'g2'^x, 'g2'^(~e1*x),
                                  sign(<'g2'^x, 'g2'^(~e1*x), $otee_id,
                                        hmac(derive_secret(derive_secret('g'^(~x_0*~x_1), 'c_hs_traffic'),
                                                           'finished'),
                                             <
                                              <'g2'^~u, 'g'^~x_0,
                                               add('g2'^~e1,
                                                   'g2'^(~u*h2('0', measure(select('g'^(~x_0*~x_1)), ~prop))
                                                        )),
                                               'g'^~x_1, pk(~ltk)>,
                                              h3(<'g2'^~u, 'g'^~x_0,
                                                  add('g2'^~e1,
                                                      'g2'^(~u*
                                                            h2('0', measure(select('g'^(~x_0*~x_1)), ~prop))
                                                           )),
                                                  'g'^~x_1, pk(~ltk)>)
                                             >)
                                       >,
                                       ~OTEE),
                                  $otee_id>,
                                 derive_secret(derive_secret('g'^(~x_0*~x_1), 'derived'), 'c_ap_traffic'))
                       ) @ #vk.7 )
                  case OTEE_Challenge_Response_case_1
                  by contradiction /* from formulas */
                next
                  case OTEE_Challenge_Response_case_2
                  by contradiction /* from formulas */
                next
                  case c_senc
                  solve( !KU( sign(<'g2'^x, 'g2'^(~e1*x), $otee_id,
                                    hmac(derive_secret(derive_secret('g'^(~x_0*~x_1), 'c_hs_traffic'),
                                                       'finished'),
                                         <
                                          <'g2'^~u, 'g'^~x_0,
                                           add('g2'^~e1,
                                               'g2'^(~u*h2('0', measure(select('g'^(~x_0*~x_1)), ~prop)))),
                                           'g'^~x_1, pk(~ltk)>,
                                          h3(<'g2'^~u, 'g'^~x_0,
                                              add('g2'^~e1,
                                                  'g2'^(~u*h2('0', measure(select('g'^(~x_0*~x_1)), ~prop))
                                                       )),
                                              'g'^~x_1, pk(~ltk)>)
                                         >)
                                   >,
                                   ~OTEE)
                         ) @ #vk.24 )
                    case OTEE_Challenge_Response_case_1
                    by contradiction /* from formulas */
                  next
                    case OTEE_Challenge_Response_case_2
                    by contradiction /* from formulas */
                  next
                    case c_sign
                    by contradiction /* from formulas */
                  qed
                qed
              next
                case c_senc
                solve( !KU( derive_secret('g'^(~x_0*~x_1), 's_hs_traffic') ) @ #vk.19 )
                  case c_derive_secret
                  by contradiction /* from formulas */
                qed
              qed
            next
              case OTEE_Challenge_Response_case_2
              solve( !KU( senc(hmac(derive_secret(derive_secret('g'^(~x_0*~x_1),
                                                                's_hs_traffic'),
                                                  'finished'),
                                    <
                                     <'g2'^~u, 'g'^~x_0,
                                      add('g2'^~e1,
                                          'g2'^(~u*h2('0', measure(select('g'^(~x_0*~x_1)), ~prop)))),
                                      'g'^~x_1>,
                                     sign(<
                                           <'g2'^~u, 'g'^~x_0,
                                            add('g2'^~e1,
                                                'g2'^(~u*h2('0', measure(select('g'^(~x_0*~x_1)), ~prop)))),
                                            'g'^~x_1>,
                                           h3(<'g2'^~u, 'g'^~x_0,
                                               add('g2'^~e1,
                                                   'g2'^(~u*h2('0', measure(select('g'^(~x_0*~x_1)), ~prop))
                                                        )),
                                               'g'^~x_1>)
                                          >,
                                          ~ltk)
                                    >),
                               derive_secret('g'^(~x_0*~x_1), 's_hs_traffic'))
                     ) @ #vk.16 )
                case Server_Hello
                solve( !KU( senc(<'g2'^x, 'g2'^(~e1*x),
                                  sign(<'g2'^x, 'g2'^(~e1*x), $otee_id,
                                        hmac(derive_secret(derive_secret('g'^(~x_0*~x_1), 'c_hs_traffic'),
                                                           'finished'),
                                             <
