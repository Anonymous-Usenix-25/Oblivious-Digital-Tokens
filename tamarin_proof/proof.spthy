      solve( OTEE_0( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x, X_00, pk(x.1)
             ) ▶₀ #j )
        case OTEE_Client_Hello
        solve( !KU( senc(sign(<
                               <'g2'^~u, 'g'^~x, add('g2'^~e1, 'g2'^e2), 'g'^~x_1>,
                               h3(<'g2'^~u, 'g'^~x, add('g2'^~e1, 'g2'^e2), 'g'^~x_1>)>,
                              ~ltk.1),
                         derive_secret('g'^(~x*~x_1), 's_hs_traffic'))
               ) @ #vk.8 )
          case Server_Hello
