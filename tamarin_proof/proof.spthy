lemma auto_ifServerAndOTEEHaveSameKeyThenTheyCommunicated [reuse]:
  all-traces
  "∀ OTEE DHE AGGR ltk pk_ltk #i #j.
    (((OTEEDHKey( OTEE, DHE ) @ #i) ∧ (AggrDHKey( AGGR, DHE ) @ #j)) ∧
     (AggrServerHelloPK( AGGR, ltk, pk_ltk ) @ #j)) ⇒
    (∃ n_1. OTEEReceiveServerHello( OTEE, pk_ltk, n_1 ) @ #i)"
/*
guarded formula characterizing all counter-examples:
"∃ OTEE DHE AGGR ltk pk_ltk #i #j.
  (OTEEDHKey( OTEE, DHE ) @ #i) ∧
  (AggrDHKey( AGGR, DHE ) @ #j) ∧
  (AggrServerHelloPK( AGGR, ltk, pk_ltk ) @ #j)
 ∧
  ∀ n_1. (OTEEReceiveServerHello( OTEE, pk_ltk, n_1 ) @ #i) ⇒ ⊥"
*/
simplify
  case 1
  solve( OTEE_0( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, pk(x)
         ) ▶₀ #i )
    case OTEE_Client_Hello
    solve( !KU( senc(sign(<<'g2'^~u, 'g'^~x_0, add('g2'^~e1, z), 'g'^~x_1>,
                           h3(<'g2'^~u, 'g'^~x_0, add('g2'^~e1, z), 'g'^~x_1>)>,
                          ~ltk),
                     derive_secret('g'^(~x*~x.1), 's_hs_traffic'))
           ) @ #vk.5 )
      case Server_Hello
      by contradiction /* from formulas */
    next
      case c_senc
      solve( !KU( derive_secret('g'^(~x*~x.1), 's_hs_traffic') ) @ #vk.12 )
        case c_derive_secret
        by contradiction /* from formulas */
      qed
    qed
  qed
next
  case 2
  solve( OTEE_0( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, pk(x)
         ) ▶₀ #i )
    case OTEE_Client_Hello
    solve( !KU( senc(sign(<<'g2'^~u, 'g'^~x_0, add('g2'^~e1, z), 'g'^~x_1>,
                           h3(<'g2'^~u, 'g'^~x_0, add('g2'^~e1, z), 'g'^~x_1>)>,
                          ~ltk),
                     derive_secret('g'^(~x*~x.1), 's_hs_traffic'))
           ) @ #vk.5 )
      case Server_Hello
      by contradiction /* from formulas */
    next
      case c_senc
      solve( !KU( derive_secret('g'^(~x*~x.1), 's_hs_traffic') ) @ #vk.12 )
        case c_derive_secret
        by contradiction /* from formulas */
      qed
    qed
  qed
qed

lemma auto_adversaryCannotKnowDHEBeforeReveal [reuse]:
  all-traces
  "∀ OTEE key DHE AGGR #i #k #l.
    (((((OTEERevealSecretKey( OTEE, key ) @ #i) ∧
        (OTEEChallengeResponseKey( OTEE, DHE ) @ #i)) ∧
       (AggrDHKey( AGGR, DHE ) @ #k)) ∧
      (!KU( DHE ) @ #l)) ∧
     (#l < #i)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ OTEE key DHE AGGR #i #k #l.
  (OTEERevealSecretKey( OTEE, key ) @ #i) ∧
  (OTEEChallengeResponseKey( OTEE, DHE ) @ #i) ∧
  (AggrDHKey( AGGR, DHE ) @ #k) ∧
  (!KU( DHE ) @ #l)
 ∧
  #l < #i"
*/
simplify
solve( !KU( 'g'^(~x*~x_1) ) @ #l )
  case OTEE_Client_Hello
  by contradiction /* from formulas */
next
  case Server_Hello_case_1
  solve( OTEE_3( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1,
                 X_11, 'g'^(~x*~x_1), srv_pk, ch_pos, ~ch_prop, int_indicator
         ) ▶₀ #i )
    case Continue_OTEE_Interrupt_With_Agent_case_1
    solve( splitEqs(0) )
      case split_case_1
      solve( splitEqs(1) )
        case split_case_1
        by contradiction /* from formulas */
      next
        case split_case_2
        by contradiction /* from formulas */
      next
        case split_case_3
        solve( splitEqs(3) )
          case split
          by contradiction /* from formulas */
        qed
      next
