lemma auto_AdversaryNeverLearnsT [reuse]:
  all-traces
  "∀ OTEE t invT g2_t g2_inv_t #i #j.
    ((OTEESecret( OTEE, t, invT, g2_t, g2_inv_t ) @ #i) ∧ (!KU( t ) @ #j)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ OTEE t invT g2_t g2_inv_t #i #j.
  (OTEESecret( OTEE, t, invT, g2_t, g2_inv_t ) @ #i) ∧ (!KU( t ) @ #j)"
*/
simplify
by solve( !KU( ~t ) @ #j )

lemma auto_AdversaryNeverLearnsInvT [reuse]:
  all-traces
  "∀ OTEE t invT g2_t g2_inv_t #i #j.
    ((OTEESecret( OTEE, t, invT, g2_t, g2_inv_t ) @ #i) ∧
     (!KU( invT ) @ #j)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ OTEE t invT g2_t g2_inv_t #i #j.
  (OTEESecret( OTEE, t, invT, g2_t, g2_inv_t ) @ #i) ∧ (!KU( invT ) @ #j)"
*/
simplify
by contradiction /* from formulas */

lemma auto_AdversaryNeverLearnsS [reuse]:
  all-traces
  "∀ AGGR s #i #j. ((AggrS( AGGR, s ) @ #i) ∧ (!KU( s ) @ #j)) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ AGGR s #i #j. (AggrS( AGGR, s ) @ #i) ∧ (!KU( s ) @ #j)"
*/
simplify
by solve( !KU( ~s ) @ #j )

lemma auto_OTEEExponentsLemma [reuse]:
  all-traces
  "∀ OTEE e1 e2 DHE AGGR #i #j #k.
    (((((OTEEExponents( OTEE, e1, e2 ) @ #i) ∧
        (OTEEDHKey( OTEE, DHE ) @ #i)) ∧
       (AggrS( AGGR, e1 ) @ #j)) ∧
      (AggrDHKey( AGGR, DHE ) @ #j)) ∧
     (!KU( e2 ) @ #k)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ OTEE e1 e2 DHE AGGR #i #j #k.
  (OTEEExponents( OTEE, e1, e2 ) @ #i) ∧
  (OTEEDHKey( OTEE, DHE ) @ #i) ∧
  (AggrS( AGGR, e1 ) @ #j) ∧
  (AggrDHKey( AGGR, DHE ) @ #j) ∧
  (!KU( e2 ) @ #k)"
*/
simplify
  case 1
  solve( OTEE_0( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00,
                 pk(~ltk)
         ) ▶₀ #i )
    case OTEE_Client_Hello
    solve( !KU( senc(sign(<<'g2'^~u, 'g'^~x_0, add('g2'^~e1, z), 'g'^~x_1>,
                           h3(<'g2'^~u, 'g'^~x_0, add('g2'^~e1, z), 'g'^~x_1>)>,
                          ~ltk),
                     derive_secret('g'^(~x*~x.1), 's_hs_traffic'))
           ) @ #vk.5 )
      case Server_Hello
      solve( !KU( senc(hmac(derive_secret(derive_secret('g'^(~x*~x_1),
                                                        's_hs_traffic'),
                                          'finished'),
                            <
                             <'g2'^~u, 'g'^~x,
                              add('g2'^~e1, 'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~prop)))),
                              'g'^~x_1>,
                             sign(<
                                   <'g2'^~u, 'g'^~x,
                                    add('g2'^~e1, 'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~prop)))),
                                    'g'^~x_1>,
                                   h3(<'g2'^~u, 'g'^~x,
                                       add('g2'^~e1,
                                           'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~prop)))),
                                       'g'^~x_1>)
                                  >,
                                  ~ltk)
                            >),
                       derive_secret('g'^(~x*~x_1), 's_hs_traffic'))
             ) @ #vk.6 )
        case Server_Hello
        solve( splitEqs(0) )
          case split
          by solve( !KU( ~u ) @ #vk.11 )
        qed
      next
        case c_senc
        solve( !KU( hmac(derive_secret(derive_secret('g'^(~x*~x_1),
                                                     's_hs_traffic'),
                                       'finished'),
                         <
                          <'g2'^~u, 'g'^~x,
                           add('g2'^~e1, 'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~prop)))),
                           'g'^~x_1>,
                          sign(<
                                <'g2'^~u, 'g'^~x,
                                 add('g2'^~e1, 'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~prop)))),
                                 'g'^~x_1>,
                                h3(<'g2'^~u, 'g'^~x,
                                    add('g2'^~e1, 'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~prop)))),
                                    'g'^~x_1>)
                               >,
                               ~ltk)
                         >)
               ) @ #vk.13 )
          case Server_Hello
          by contradiction /* from formulas */
        next
          case c_hmac
          solve( !KU( sign(<
                            <'g2'^~u, 'g'^~x,
                             add('g2'^~e1, 'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~prop)))),
                             'g'^~x_1>,
                            h3(<'g2'^~u, 'g'^~x,
                                add('g2'^~e1, 'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~prop)))),
                                'g'^~x_1>)
                           >,
                           ~ltk)
                 ) @ #vk.20 )
            case Server_Hello
            by contradiction /* from formulas */
          next
            case c_sign
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case c_senc
      solve( !KU( senc(hmac(derive_secret(derive_secret('g'^(~x*~x.1),
                                                        's_hs_traffic'),
                                          'finished'),
                            <<'g2'^~u, 'g'^~x_0, add('g2'^~e1, z), 'g'^~x_1>,
                             sign(<<'g2'^~u, 'g'^~x_0, add('g2'^~e1, z), 'g'^~x_1>,
                                   h3(<'g2'^~u, 'g'^~x_0, add('g2'^~e1, z), 'g'^~x_1>)>,
                                  ~ltk)
                            >),
                       derive_secret('g'^(~x*~x.1), 's_hs_traffic'))
             ) @ #vk.6 )
        case Server_Hello
        solve( !KU( sign(<
                          <'g2'^~u, 'g'^~x,
                           add('g2'^~e1, 'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~prop)))),
                           'g'^~x_1>,
                          h3(<'g2'^~u, 'g'^~x,
                              add('g2'^~e1, 'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~prop)))),
                              'g'^~x_1>)
                         >,
                         ~ltk)
               ) @ #vk.11 )
          case Server_Hello
          by contradiction /* from formulas */
        next
          case c_sign
          by contradiction /* from formulas */
        qed
      next
        case c_senc
        solve( !KU( sign(<<'g2'^~u, 'g'^~x_0, add('g2'^~e1, z), 'g'^~x_1>,
                          h3(<'g2'^~u, 'g'^~x_0, add('g2'^~e1, z), 'g'^~x_1>)>,
                         ~ltk)
               ) @ #vk.11 )
          case Server_Hello
          by contradiction /* from formulas */
        next
          case c_sign
          by contradiction /* from formulas */
        qed
      qed
    qed
  qed
next
  case 2
  solve( OTEE_0( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00,
                 pk(~ltk)
         ) ▶₀ #i )
    case OTEE_Client_Hello
    solve( !KU( senc(sign(<<'g2'^~u, 'g'^~x_0, add('g2'^~e1, z), 'g'^~x_1>,
                           h3(<'g2'^~u, 'g'^~x_0, add('g2'^~e1, z), 'g'^~x_1>)>,
                          ~ltk),
                     derive_secret('g'^(~x*~x.1), 's_hs_traffic'))
           ) @ #vk.5 )
      case Server_Hello
      solve( !KU( senc(hmac(derive_secret(derive_secret('g'^(~x*~x_0),
                                                        's_hs_traffic'),
                                          'finished'),
