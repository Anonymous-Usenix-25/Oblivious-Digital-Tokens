restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction Inequality:
  "∀ x #i. (Neq( x, x ) @ #i) ⇒ (⊥)"
  // safety formula

restriction Unique:
  "∀ x #i #j. ((Unique( x ) @ #i) ∧ (Unique( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction OnlyOneNP:
  "∀ x y #i #j.
    ((InitializeNP( x ) @ #i) ∧ (InitializeNP( y ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction OnlyOneAggressor:
  "∀ AGGR AGGR2 #i #j.
    ((AggressorInitialized( AGGR ) @ #i) ∧
     (AggressorInitialized( AGGR2 ) @ #j)) ⇒
    (#i = #j)"
  // safety formula

restriction AdversaryDoesNotExtractPropertiesFromOwnAgents:
  "∀ A prop #i #j.
    ((AdversaryExtractAgentProperties( A, prop ) @ #i) ∧
     (AdversaryCreateAgent( A, prop ) @ #j)) ⇒
    (⊥)"
  // safety formula

restriction OTEESessionCannotInterleaveWithSameNonce:
  "∀ OTEE u n1 #i #j.
    ((OTEESessionAggrNonce( OTEE, u, n1 ) @ #i) ∧
     (OTEESessionAggrNonce( OTEE, u, n1 ) @ #j)) ⇒
    (∀ u_2 #k.
      ((((OTEESessionAggrNonce( OTEE, u_2, n1 ) @ #k) ∧ (#i < #k)) ∧
        (#k < #j)) ∧
       (¬(u = u_2))) ⇒
      (⊥))"
  // safety formula

restriction OTEESessionHasToFinishBeforeStartingNext:
  "∀ OTEE u u_2 n_1 #i #j.
    ((((OTEESessionAggrNonce( OTEE, u, n_1 ) @ #i) ∧
       (OTEESessionAggrNonce( OTEE, u_2, n_1 ) @ #j)) ∧
      (#i < #j)) ∧
     (¬(u = u_2))) ⇒
    (∃ C #k.
      ((OTEEChallengeResponse( OTEE, C, u ) @ #k) ∧ (#i < #k)) ∧ (#k < #j))"

lemma auto_adversaryCannotCompromiseNPLTK [reuse]:
  all-traces
  "∀ NP ltk #i #j.
    ((InitializeNP_LTK( NP, ltk ) @ #i) ∧ (!KU( ltk ) @ #j)) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ NP ltk #i #j. (InitializeNP_LTK( NP, ltk ) @ #i) ∧ (!KU( ltk ) @ #j)"
*/
simplify
by solve( !KU( ~ltk ) @ #j )

lemma auto_adversaryCannotKnowAggressorLtk [reuse]:
  all-traces
  "∀ AGGR ltk pk_ltk #i #j.
    ((AggrServerHelloPK( AGGR, ltk, pk_ltk ) @ #i) ∧ (!KU( ltk ) @ #j)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ AGGR ltk pk_ltk #i #j.
  (AggrServerHelloPK( AGGR, ltk, pk_ltk ) @ #i) ∧ (!KU( ltk ) @ #j)"
*/
simplify
solve( !KU( ~ltk ) @ #j )
  case OTEE_Challenge_Response_case_1
  by solve( Aggressor_0( $AGGR, ~prop, $A, ~ltk ) ▶₀ #i )
next
  case OTEE_Challenge_Response_case_2
  by solve( Aggressor_0( $AGGR, ~prop, $A, ~ltk ) ▶₀ #i )
next
  case OTEE_Challenge_Response_case_3
  by solve( Aggressor_0( $AGGR, ~prop, $A, ~ltk ) ▶₀ #i )
next
  case OTEE_Challenge_Response_case_4
  by solve( Aggressor_0( $AGGR, ~prop, $A, ~ltk ) ▶₀ #i )
next
  case OTEE_Challenge_Response_case_5
  by solve( Aggressor_0( $AGGR, ~prop, $A, ~ltk ) ▶₀ #i )
next
  case fresh
  by solve( Aggressor_0( $AGGR, ~prop, $A, ~ltk ) ▶₀ #i )
qed

lemma auto_adversaryCannotRecoverAggressorDHShare [reuse]:
  all-traces
  "∀ AGGR x_0 x_1 X_11 #i #j.
    ((AggrDH( AGGR, x_0, x_1, X_11 ) @ #i) ∧ (!KU( x_1 ) @ #j)) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ AGGR x_0 x_1 X_11 #i #j.
  (AggrDH( AGGR, x_0, x_1, X_11 ) @ #i) ∧ (!KU( x_1 ) @ #j)"
*/
simplify
by solve( !KU( ~x_1 ) @ #j )

lemma auto_adversaryCannotFindPropertiesFromAggressor [reuse]:
  all-traces
  "∀ OTEE ch_pos ch_prop A #i #j #k.
    (((OTEEMeasure( OTEE, ch_pos, ch_prop ) @ #i) ∧
      (OUT_Aggressor_0( ch_prop ) @ #j)) ∧
     (AdversaryCreateAgent( A, ch_prop ) @ #k)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ OTEE ch_pos ch_prop A #i #j #k.
  (OTEEMeasure( OTEE, ch_pos, ch_prop ) @ #i) ∧
  (OUT_Aggressor_0( ch_prop ) @ #j) ∧
  (AdversaryCreateAgent( A, ch_prop ) @ #k)"
*/
simplify
solve( Aggressor_0( $AGGR, ~prop, $A, ~ltk ) ▶₀ #j )
  case Aggressor_Create_Agent
  by solve( !KU( ~prop ) @ #vk.3 )
qed

