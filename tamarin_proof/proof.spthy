lemma auto_adversaryCannotKnowMeasurementPositionBeforeMeasurement [reuse]:
  all-traces
  "∀ OTEE ch_pos ch_prop AGGR #i #j.
    ((OTEEMeasure( OTEE, ch_pos, ch_prop ) @ #i) ∧
     (AggrMeasurementSelection( AGGR, ch_pos ) @ #j)) ⇒
    (¬(∃ #k. (!KU( ch_pos ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ OTEE ch_pos ch_prop AGGR #i #j.
  (OTEEMeasure( OTEE, ch_pos, ch_prop ) @ #i) ∧
  (AggrMeasurementSelection( AGGR, ch_pos ) @ #j)
 ∧
  ∃ #k. (!KU( ch_pos ) @ #k) ∧ #k < #i"
*/
simplify
solve( splitEqs(0) )
  case split_case_1
  by contradiction /* from formulas */
next
  case split_case_2
  by contradiction /* from formulas */
next
  case split_case_3
  solve( Aggressor_0( $AGGR, ~prop, $A, ~ltk ) ▶₀ #j )
    case Aggressor_Create_Agent
    solve( OTEEMeasure( OTEE, select('g'^(~x*~x_1)), ch_prop ) @ #i )
      case Interrupt_OTEE_Memory_Read
      solve( OTEE_2( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1,
                     X_11, 'g'^(~x*~x_1), srv_pk
             ) ▶₀ #i )
