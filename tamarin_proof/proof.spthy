                       add('g2'^~e1.3564, 'g2'^(x.7121*inv((~e1.3564*x.7122)))), 'g'^~x_1.3568
                      >,
                      h3(<n_0.3571, X_00.3569,
                          add('g2'^~e1.3564, 'g2'^(x.7121*inv((~e1.3564*x.7122)))), 'g'^~x_1.3568>)
                     >,
                     x.7124)
        srv_pk
              = pk(x.7124)
        x     = ~x_1.3568
        z     = 'g2'^(x.7121*inv((~e1.3564*x.7122)))
        ~x.1  = ~u.3566
        z.1   = true
        ~x.2  = ~x_1.3568
        z.2   = 'g2'^(x.7121*inv(x.7122))
        z.3   = 'g2'
        z.4   = 'g'^(~x_1.3568*inv(~u.3566))

    44. ~e1   = ~e1.3564
        ~u    = ~u.3566
        ~x_0  = ~x_0.3567
        ~x_1  = ~u.3566
        X_00  = X_00.3569
        e2    = (x.7121*inv((~e1.3564*x.7122)))
        n_0   = n_0.3571
        rec_server_certificate_verify_ext_signed
              = sign(<
                      <n_0.3571, X_00.3569,
                       add('g2'^~e1.3564, 'g2'^(x.7121*inv((~e1.3564*x.7122)))), 'g'^~u.3566>,
                      h3(<n_0.3571, X_00.3569,
                          add('g2'^~e1.3564, 'g2'^(x.7121*inv((~e1.3564*x.7122)))), 'g'^~u.3566>)
                     >,
                     x.7124)
        srv_pk
              = pk(x.7124)
        x     = ~x_0.3567
        z     = 'g2'^(x.7121*inv((~e1.3564*x.7122)))
        ~x.1  = ~u.3566
        z.1   = true
        ~x.2  = ~x_0.3567
        z.2   = 'g2'^(x.7121*inv(x.7122))
        z.3   = 'g2'^(~x_0.3567*inv(~u.3566))
        z.4   = 'g'

    45. ~e1   = ~e1.3564
        ~u    = ~u.3566
        ~x_0  = ~x_0.3567
        ~x_1  = ~x_1.3568
        X_00  = X_00.3569
        e2    = e2.3570
        n_0   = n_0.3571
        rec_server_certificate_verify_ext_signed
              = sign(<
                      <n_0.3571, X_00.3569, add('g2'^~e1.3564, 'g2'^e2.3570), 'g'^~x_1.3568>,
                      h3(<n_0.3571, X_00.3569, add('g2'^~e1.3564, 'g2'^e2.3570), 'g'^~x_1.3568
                         >)
                     >,
                     x.7124)
        srv_pk
              = pk(x.7124)
        x     = (~x_0.3567*~x_1.3568*inv(~u.3566))
        z     = 'g2'^e2.3570
        ~x.1  = ~x_0.3567
        z.1   = true
        ~x.2  = ~x_1.3568
        z.2   = 'g2'^(~e1.3564*e2.3570)
        z.3   = 'g2'^(~x_0.3567*inv(~u.3566))
        z.4   = 'g'^(~x_1.3568*inv(~u.3566))

    46. ~e1   = ~e1.3564
        ~u    = ~u.3566
        ~x_0  = ~x_0.3567
        ~x_1  = ~x_1.3568
        X_00  = X_00.3569
        e2    = inv((~e1.3564*x.7122))
        n_0   = n_0.3571
        rec_server_certificate_verify_ext_signed
              = sign(<
                      <n_0.3571, X_00.3569, add('g2'^~e1.3564, 'g2'^inv((~e1.3564*x.7122))),
                       'g'^~x_1.3568>,
                      h3(<n_0.3571, X_00.3569,
                          add('g2'^~e1.3564, 'g2'^inv((~e1.3564*x.7122))), 'g'^~x_1.3568>)
                     >,
                     x.7124)
        srv_pk
              = pk(x.7124)
        x     = (~x_0.3567*~x_1.3568*inv(~u.3566))
        z     = 'g2'^inv((~e1.3564*x.7122))
        ~x.1  = ~x_0.3567
        z.1   = true
        ~x.2  = ~x_1.3568
        z.2   = 'g2'^inv(x.7122)
        z.3   = 'g2'^(~x_0.3567*inv(~u.3566))
        z.4   = 'g'^(~x_1.3568*inv(~u.3566))

    47. ~e1   = ~e1.3564
        ~u    = ~u.3566
        ~x_0  = ~x_0.3567
        ~x_1  = ~x_1.3568
        X_00  = X_00.3569
        e2    = (x.7122*inv(~e1.3564))
        n_0   = n_0.3571
        rec_server_certificate_verify_ext_signed
              = sign(<
                      <n_0.3571, X_00.3569, add('g2'^~e1.3564, 'g2'^(x.7122*inv(~e1.3564))),
                       'g'^~x_1.3568>,
                      h3(<n_0.3571, X_00.3569,
                          add('g2'^~e1.3564, 'g2'^(x.7122*inv(~e1.3564))), 'g'^~x_1.3568>)
                     >,
                     x.7124)
        srv_pk
              = pk(x.7124)
        x     = (~x_0.3567*~x_1.3568*inv(~u.3566))
        z     = 'g2'^(x.7122*inv(~e1.3564))
        ~x.1  = ~x_0.3567
        z.1   = true
        ~x.2  = ~x_1.3568
        z.2   = 'g2'^x.7122
        z.3   = 'g2'^(~x_0.3567*inv(~u.3566))
        z.4   = 'g'^(~x_1.3568*inv(~u.3566))

    48. ~e1   = ~e1.3565
        ~u    = ~u.3567
        ~x_0  = ~x_0.3568
        ~x_1  = ~x_1.3569
        X_00  = X_00.3570
        e2    = (x.7123*inv((~e1.3565*x.7124)))
        n_0   = n_0.3572
        rec_server_certificate_verify_ext_signed
              = sign(<
                      <n_0.3572, X_00.3570,
                       add('g2'^~e1.3565, 'g2'^(x.7123*inv((~e1.3565*x.7124)))), 'g'^~x_1.3569
                      >,
                      h3(<n_0.3572, X_00.3570,
                          add('g2'^~e1.3565, 'g2'^(x.7123*inv((~e1.3565*x.7124)))), 'g'^~x_1.3569>)
                     >,
                     x.7126)
        srv_pk
              = pk(x.7126)
        x     = (~x_0.3568*~x_1.3569*inv(~u.3567))
        z     = 'g2'^(x.7123*inv((~e1.3565*x.7124)))
        ~x.1  = ~x_0.3568
        z.1   = true
        ~x.2  = ~x_1.3569
        z.2   = 'g2'^(x.7123*inv(x.7124))
        z.3   = 'g2'^(~x_0.3568*inv(~u.3567))
        z.4   = 'g'^(~x_1.3569*inv(~u.3567))
  */

rule (modulo E) No_Interrupt_OTEE_Memory_Read:
   [
   OTEE_2( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1, X_11,
           DHE, srv_pk
   ),
   !AgentInstance( ~aid, $A, $D, ~prop )
   ]
  --[
  OTEEHonestPropertyRead( $OTEE, $D, $A, ~prop ), OTEESession( $OTEE, ~u ),
  OTEESessionAggrNonce( $OTEE, ~u, n_1 ),
  OTEEPosition( $OTEE, select(DHE) ),
  OTEEMeasure( $OTEE, select(DHE), ~prop )
  ]->
   [
   OTEE_3( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1, X_11,
           DHE, srv_pk, select(DHE), ~prop, '0'
   ),
   Out( select(DHE) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) No_Interrupt_Prepared_Memory_Read:
   [
   OTEE_2( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1, X_11,
           DHE, srv_pk
   ),
   In( ~adv_prop )
   ]
  --[
  PreparedMemoryRead( $OTEE, $D ), RequireOSCompromise( $D ),
  OTEESession( $OTEE, ~u ), OTEESessionAggrNonce( $OTEE, ~u, n_1 ),
  OTEEMeasure( $OTEE, select(DHE), ~adv_prop )
  ]->
   [
   OTEE_3( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1, X_11,
           DHE, srv_pk, select(DHE), ~adv_prop, '0'
   ),
   Out( select(DHE) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Interrupt_OTEE_Memory_Read:
   [
   OTEE_2( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1, X_11,
           DHE, srv_pk
   )
   ]
  --[
  RequireOSCompromise( $D ), InterruptOTEEMemoryRead( $OTEE, $D ),
  OTEESession( $OTEE, ~u ), OTEESessionAggrNonce( $OTEE, ~u, n_1 ),
  OTEEMeasure( $OTEE, select(DHE), 'null' )
  ]->
   [
   OTEE_Interrupt( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1,
                   X_11, DHE, srv_pk
   ),
   Out( select(DHE) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Continue_OTEE_Interrupt_With_Agent:
   [
   OTEE_Interrupt( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1,
                   X_11, DHE, srv_pk
   ),
   !AgentInstance( ~aid, $A, $D2, ~prop )
   ]
  --[
  ResumeOTEE( $OTEE, $D ), RequireOSCompromise( $D ),
  RequireOSCompromise( $D2 ), OTEESession( $OTEE, ~u ),
  OTEESessionAggrNonce( $OTEE, ~u, n_1 )
  ]->
   [
   OTEE_3( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1, X_11,
           DHE, srv_pk, select(DHE), ~prop, '1'
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) OTEE_Challenge_Response:
   [
   OTEE_3( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1, X_11,
           DHE, srv_pk, ch_pos, ~ch_prop, int_indicator
   ),
   !OTEE_Ltk( $OTEE, ~OTEE_ltk ), Fr( ~t )
   ]
  --[
  Neq( X_11, 'g' ), Neq( X_11, DH_neutral ),
  Neq( calculate_z('g2', ~u, ~t,
                   calculate_witness(int_indicator, ch_pos, ~ch_prop), n_1),
       'g2'
  ),
  Neq( calculate_z('g2', ~u, ~t,
                   calculate_witness(int_indicator, ch_pos, ~ch_prop), n_1),
       DH_neutral
  ),
  Neq( calculate_z('g2', ~u, ~t,
                   calculate_witness(int_indicator, ch_pos, ~ch_prop), n_1),
       'g'
  ),
  Neq( calculate_z('g2', ~u, ~t,
                   calculate_witness(int_indicator, ch_pos, ~ch_prop), n_1),
       X_11
  ),
  Neq( calculate_z('g2', ~u, ~t,
                   calculate_witness(int_indicator, ch_pos, ~ch_prop), n_1),
       'g'^~x_0
  ),
  OTEEChallengeResponse( $OTEE, $D, ~u ), OTEESession( $OTEE, ~u ),
  OTEEWitness( calculate_witness(int_indicator, ch_pos, ~ch_prop) ),
  OTEEZ( calculate_z('g2', ~u, ~t,
                     calculate_witness(int_indicator, ch_pos, ~ch_prop), n_1)
  ),
  OTEESecret( $OTEE, ~t, inv(~t), 'g2'^~t, 'g2'^inv(~t) ),
  OTEEChallengeResponseDH( $OTEE, ~x_0 ),
  OTEEChallengeResponseKey( $OTEE, DHE ),
  OTEESessionAggrNonce( $OTEE, ~u, n_1 ),
  OTEERevealSecretKey( $OTEE, ~x_0 )
  ]->
   [
   Out( <'OTEE_challenge_response',
         senc(calc_client_finished(n_0, X_00, n_1, X_11, srv_pk, DHE),
              client_handshake_traffic_secret(DHE)),
         senc(client_ODT_response_payload(calculate_y('g2', ~t),
                                          calculate_z('g2', ~u, ~t,
                                                      calculate_witness(int_indicator, ch_pos, ~ch_prop),
                                                      n_1),
                                          sign(client_ODT_signature_payload(calculate_y('g2', ~t),
                                                                            calculate_z('g2', ~u, ~t,
                                                                                        calculate_witness(int_indicator,
                                                                                                          ch_pos,
                                                                                                          ~ch_prop),
                                                                                        n_1),
                                                                            $OTEE,
                                                                            calc_client_finished(n_0, X_00,
                                                                                                 n_1, X_11,
                                                                                                 srv_pk,
                                                                                                 DHE)),
                                               ~OTEE_ltk),
                                          $OTEE),
              client_application_traffic_secret(DHE)),
         ~x_0>
   )
   ]

  /*
  rule (modulo AC) OTEE_Challenge_Response:
     [
     OTEE_3( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1, X_11,
             DHE, srv_pk, ch_pos, ~ch_prop, int_indicator
     ),
     !OTEE_Ltk( $OTEE, ~OTEE_ltk ), Fr( ~t )
     ]
    --[
    Neq( X_11, 'g' ), Neq( X_11, DH_neutral ), Neq( z, 'g2' ),
    Neq( z, DH_neutral ), Neq( z, 'g' ), Neq( z, X_11 ), Neq( z, 'g'^~x_0 ),
    OTEEChallengeResponse( $OTEE, $D, ~u ), OTEESession( $OTEE, ~u ),
    OTEEWitness( h2(int_indicator, measure(ch_pos, ~ch_prop)) ), OTEEZ( z ),
    OTEESecret( $OTEE, ~t, inv(~t), 'g2'^~t, 'g2'^inv(~t) ),
    OTEEChallengeResponseDH( $OTEE, ~x_0 ),
    OTEEChallengeResponseKey( $OTEE, DHE ),
    OTEESessionAggrNonce( $OTEE, ~u, n_1 ),
    OTEERevealSecretKey( $OTEE, ~x_0 )
    ]->
     [
     Out( <'OTEE_challenge_response',
           senc(hmac(derive_secret(derive_secret(DHE, 'c_hs_traffic'), 'finished'),
                     <<n_0, X_00, n_1, X_11, srv_pk>, h3(<n_0, X_00, n_1, X_11, srv_pk>)>),
                derive_secret(DHE, 'c_hs_traffic')),
           senc(<'g2'^~t, z,
                 sign(<'g2'^~t, z, $OTEE,
                       hmac(derive_secret(derive_secret(DHE, 'c_hs_traffic'), 'finished'),
                            <<n_0, X_00, n_1, X_11, srv_pk>, h3(<n_0, X_00, n_1, X_11, srv_pk>)>)
                      >,
                      ~OTEE_ltk),
                 $OTEE>,
                derive_secret(derive_secret(DHE, 'derived'), 'c_ap_traffic')),
           ~x_0>
     )
     ]
    variants (modulo AC)
    1. ~ch_prop
             = ~ch_prop.34
       ~u    = ~u.37
       ch_pos
             = ch_pos.42
       int_indicator
             = int_indicator.43
       n_1   = add(DH_neutral,
                   'g2'^(~u.37*h2(int_indicator.43, measure(ch_pos.42, ~ch_prop.34))))
       z     = DH_neutral

    2. ~ch_prop
             = ~ch_prop.36
       ~t    = ~t.37
       ~u    = ~u.39
       ch_pos
             = ch_pos.44
       int_indicator
             = int_indicator.45
       n_1   = n_1.47
       z     = sub(n_1.47,
                   'g2'^(~u.39*h2(int_indicator.45, measure(ch_pos.44, ~ch_prop.36))))^~t.37

    3. ~ch_prop
             = ~ch_prop.44
       ~t    = ~t.45
       ~u    = ~u.47
       ch_pos
             = ch_pos.52
       int_indicator
             = int_indicator.53
       n_1   = add(z.63^inv(~t.45),
                   'g2'^(~u.47*h2(int_indicator.53, measure(ch_pos.52, ~ch_prop.44))))
       z     = z.63

    4. ~ch_prop
             = ~ch_prop.945
       ~t    = ~t.946
       ~u    = ~u.948
       ch_pos
             = ch_pos.953
       int_indicator
             = int_indicator.954
       n_1   = add(x.1885,
                   'g2'^(~u.948*h2(int_indicator.954, measure(ch_pos.953, ~ch_prop.945))))
       z     = x.1885^~t.946

    5. ~ch_prop
             = ~ch_prop.946
       ~t    = ~t.947
       ~u    = ~u.949
       ch_pos
             = ch_pos.954
       int_indicator
             = int_indicator.955
       n_1   = add(x.1886^x.1887,
                   'g2'^(~u.949*h2(int_indicator.955, measure(ch_pos.954, ~ch_prop.946))))
       z     = x.1886^(~t.947*x.1887)

    6. ~ch_prop
             = ~ch_prop.946
       ~t    = ~t.947
       ~u    = ~u.949
       ch_pos
             = ch_pos.954
       int_indicator
             = int_indicator.955
       n_1   = add(x.1886^inv((~t.947*x.1887)),
                   'g2'^(~u.949*h2(int_indicator.955, measure(ch_pos.954, ~ch_prop.946))))
       z     = x.1886^inv(x.1887)

    7. ~ch_prop
             = ~ch_prop.946
       ~t    = ~t.947
       ~u    = ~u.949
       ch_pos
             = ch_pos.954
       int_indicator
             = int_indicator.955
       n_1   = add(x.1886^(x.1887*inv(~t.947)),
                   'g2'^(~u.949*h2(int_indicator.955, measure(ch_pos.954, ~ch_prop.946))))
       z     = x.1886^x.1887

    8. ~ch_prop
             = ~ch_prop.947
       ~t    = ~t.948
       ~u    = ~u.950
       ch_pos
             = ch_pos.955
       int_indicator
             = int_indicator.956
       n_1   = add(x.1887^(x.1888*inv((~t.948*x.1889))),
                   'g2'^(~u.950*h2(int_indicator.956, measure(ch_pos.955, ~ch_prop.947))))
       z     = x.1887^(x.1888*inv(x.1889))
  */

rule (modulo E) Server_Finished[derivchecks]:
   [
   Aggressor_1( $AGGR, 'g', 'g2', ~prop, ~s, $A, ~ltk, n_0, X_00, n_1, ~x_1,
                X_11, DHE
   ),
   In( <senc(client_finished, client_handshake_traffic_secret(DHE)),
        senc(client_ODT_response_payload('g2'^Y, 'g2'^Z, sig, $otee_id),
             client_application_traffic_secret(DHE)),
        pk(~OTEE), NP_OTEE_signature>
   ),
   !NP_Pk( $NP, NP_pk )
   ]
  --[
  Neq( 'g2'^Y, 'g2' ), Neq( 'g2'^Y, DH_neutral ), Neq( 'g2'^Y, n_1 ),
  Neq( 'g2'^Y, 'g2'^Z ), Neq( 'g2'^Z, 'g2' ), Neq( 'g2'^Z, DH_neutral ),
  Neq( 'g2'^Z, n_1 ),
  Eq( verify(NP_OTEE_signature, <$otee_id, pk(~OTEE)>, NP_pk), true ),
  Eq( client_finished,
      calc_client_finished(n_0, X_00, n_1, X_11, pk(~ltk), DHE)
  ),
  Eq( 'g2'^Z, 'g2'^Y^~s ),
  Eq( verify(sig,
             client_ODT_signature_payload('g2'^Y, 'g2'^Z, $otee_id, client_finished),
             pk(~OTEE)),
      true
  ),
  AcceptVerificationWithAgent( $AGGR, $otee_id, $A, ~prop ),
  AcceptVerification( $AGGR, $otee_id ),
  AcceptVerificationDHE( $AGGR, DHE ),
  AcceptVerificationPosition( $AGGR, select(DHE) )
  ]->
   [ Aggressor_Done( $AGGR ) ]

  /*
  rule (modulo AC) Server_Finished[derivchecks]:
     [
     Aggressor_1( $AGGR, 'g', 'g2', ~prop, ~s, $A, ~ltk, n_0, X_00, n_1, ~x_1,
                  X_11, DHE
     ),
     In( <senc(client_finished, derive_secret(DHE, 'c_hs_traffic')),
          senc(<z, z.1, sig, $otee_id>,
