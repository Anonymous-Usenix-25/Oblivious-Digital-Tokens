        case split
        by contradiction /* cyclic */
      qed
    qed
  next
    case OTEE_Challenge_Response_case_07
    by contradiction /* non-normal exponentiation rule instance */
  next
    case OTEE_Challenge_Response_case_08
    by contradiction /* non-normal exponentiation rule instance */
  next
