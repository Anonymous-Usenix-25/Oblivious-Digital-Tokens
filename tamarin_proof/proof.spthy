lemma auto_ImpossibleBeforeUCH [reuse]:
  all-traces
  "∀ u #i #j.
    (((ImpossibleBeforeUCH( u ) @ #i) ∧ (!KU( u ) @ #j)) ∧ (#j < #i)) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ u #i #j. (ImpossibleBeforeUCH( u ) @ #i) ∧ (!KU( u ) @ #j) ∧ #j < #i"
*/
simplify
solve( ImpossibleBeforeUCH( u ) @ #i )
  case OTEE_Client_Hello_case_1
  by solve( !KU( ~u ) @ #j )
next
  case OTEE_Client_Hello_case_2
  by solve( !KU( ~u ) @ #vk.1 )
next
  case OTEE_Client_Hello_case_3
  solve( !KU( 'g2'^~u ) @ #j )
    case OTEE_Challenge_Response_case_01
    by contradiction /* non-normal exponentiation rule instance */
  next
    case OTEE_Challenge_Response_case_02
    by contradiction /* non-normal exponentiation rule instance */
  next
    case OTEE_Challenge_Response_case_03
    solve( splitEqs(1) )
      case split_case_1
      solve( splitEqs(2) )
        case split
        by contradiction /* cyclic */
      qed
    next
      case split_case_2
      solve( splitEqs(2) )
        case split
        by contradiction /* cyclic */
      qed
    qed
  next
    case OTEE_Challenge_Response_case_04
    solve( splitEqs(1) )
      case split_case_1
      solve( splitEqs(2) )
        case split
        by contradiction /* cyclic */
      qed
    next
      case split_case_2
