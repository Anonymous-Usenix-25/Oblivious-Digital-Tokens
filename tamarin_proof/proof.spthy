lemma auto_twoOTEEsCannotHaveSameDHE [reuse]:
  all-traces
  "∀ OTEE OTEE2 DHE #i #j.
    (((OTEEDHKey( OTEE, DHE ) @ #i) ∧ (OTEEDHKey( OTEE2, DHE ) @ #j)) ∧
     (¬(#i = #j))) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ OTEE OTEE2 DHE #i #j.
  (OTEEDHKey( OTEE, DHE ) @ #i) ∧ (OTEEDHKey( OTEE2, DHE ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
  case 1
  solve( OTEE_0( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, pk(x)
         ) ▶₀ #i )
    case OTEE_Client_Hello
    solve( OTEE_0( ~tee_id.1, $OTEE.1, 'g', 'g2', $D.1, ~u.1, n_0, ~x_0.1,
                   X_00, pk(x.3)
           ) ▶₀ #j )
      case OTEE_Client_Hello
      solve( splitEqs(0) )
        case split_case_01
        solve( splitEqs(1) )
          case split
          by contradiction /* from formulas */
        qed
      next
        case split_case_02
        by contradiction /* from formulas */
      next
        case split_case_03
        solve( splitEqs(1) )
          case split
          by contradiction /* from formulas */
        qed
      next
        case split_case_04
        solve( splitEqs(1) )
          case split
          by contradiction /* from formulas */
        qed
      next
        case split_case_05
        by contradiction /* from formulas */
      next
        case split_case_06
        solve( splitEqs(1) )
          case split
          by contradiction /* from formulas */
        qed
      next
        case split_case_07
        solve( splitEqs(1) )
          case split
          by contradiction /* from formulas */
        qed
      next
        case split_case_08
        solve( splitEqs(1) )
          case split
          by contradiction /* from formulas */
        qed
      next
        case split_case_09
        solve( splitEqs(1) )
          case split
          by contradiction /* from formulas */
        qed
      next
        case split_case_10
        solve( splitEqs(1) )
          case split
          by contradiction /* from formulas */
        qed
      next
        case split_case_11
        solve( splitEqs(1) )
          case split
          by contradiction /* from formulas */
        qed
      next
        case split_case_12
        solve( splitEqs(1) )
          case split
          by contradiction /* from formulas */
        qed
      qed
    qed
  qed
next
  case 2
