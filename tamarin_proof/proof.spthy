        case split
        by contradiction /* cyclic */
      qed
    qed
  next
    case OTEE_Challenge_Response_case_05
    by contradiction /* non-normal exponentiation rule instance */
  next
    case OTEE_Challenge_Response_case_06
    solve( splitEqs(1) )
      case split_case_1
