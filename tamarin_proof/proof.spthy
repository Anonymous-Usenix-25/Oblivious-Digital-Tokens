        z.4   = 'g'^(~x_1.3567*inv(~u.3565))

    42. ~e1   = ~e1.3563
        ~u    = ~u.3565
        ~x_0  = ~x_0.3566
        ~x_1  = ~x_1.3567
        X_00  = X_00.3568
        e2    = (x.7121*inv((~e1.3563*x.7122)))
        n_0   = n_0.3570
        rec_server_certificate_verify_ext_signed
              = rec_server_certificate_verify_ext_signed.3571
        srv_pk
              = srv_pk.3573
        x     = (~x_0.3566*~x_1.3567*inv(~u.3565))
        z     = 'g2'^(x.7121*inv((~e1.3563*x.7122)))
        ~x.1  = ~x_0.3566
        z.1   = verify(rec_server_certificate_verify_ext_signed.3571,
                       <
                        <n_0.3570, X_00.3568,
                         add('g2'^~e1.3563, 'g2'^(x.7121*inv((~e1.3563*x.7122)))), 'g'^~x_1.3567
                        >,
                        h3(<n_0.3570, X_00.3568,
                            add('g2'^~e1.3563, 'g2'^(x.7121*inv((~e1.3563*x.7122)))), 'g'^~x_1.3567>)
                       >,
                       srv_pk.3573)
        ~x.2  = ~x_1.3567
        z.2   = 'g2'^(x.7121*inv(x.7122))
        z.3   = 'g2'^(~x_0.3566*inv(~u.3565))
        z.4   = 'g'^(~x_1.3567*inv(~u.3565))

    43. ~e1   = ~e1.3564
        ~u    = ~u.3566
        ~x_0  = ~u.3566
        ~x_1  = ~x_1.3568
        X_00  = X_00.3569
        e2    = (x.7121*inv((~e1.3564*x.7122)))
