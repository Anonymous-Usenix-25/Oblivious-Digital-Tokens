        solve( Aggressor_0( $AGGR.1, ~prop.1, $A.1, ~ltk.1 ) ▶₀ #j )
          case Aggressor_Create_Agent
          by contradiction /* from formulas */
        qed
      qed
    next
      case split_case_6
      solve( Aggressor_0( $AGGR, ~prop, $A, ~ltk ) ▶₀ #i )
        case Aggressor_Create_Agent
        solve( Aggressor_0( $AGGR.1, ~prop.1, $A.1, ~ltk.1 ) ▶₀ #j )
          case Aggressor_Create_Agent
          by contradiction /* from formulas */
        qed
      qed
    qed
  qed
qed

lemma auto_adversaryCannotLearnOTEELtk [reuse]:
  all-traces
  "∀ NP OTEE OTEE_ltk #i #j.
    ((OTEERegisterOTEE( NP, OTEE, OTEE_ltk ) @ #i) ∧
     (!KU( OTEE_ltk ) @ #j)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ NP OTEE OTEE_ltk #i #j.
  (OTEERegisterOTEE( NP, OTEE, OTEE_ltk ) @ #i) ∧ (!KU( OTEE_ltk ) @ #j)"
*/
simplify
by solve( !KU( ~OTEE_ltk ) @ #j )

lemma auto_OTEEOrder [reuse]:
  all-traces
  "∀ OTEE x_0 u pk_ltk n_1 #i #j.
    (((((OTEEChallengeResponseDH( OTEE, x_0 ) @ #i) ∧
        (OTEESession( OTEE, u ) @ #i)) ∧
       (OTEEReceiveServerHello( OTEE, pk_ltk, n_1 ) @ #j)) ∧
      (OTEESession( OTEE, u ) @ #j)) ∧
     (#i < #j)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ OTEE x_0 u pk_ltk n_1 #i #j.
  (OTEEChallengeResponseDH( OTEE, x_0 ) @ #i) ∧
  (OTEESession( OTEE, u ) @ #i) ∧
  (OTEEReceiveServerHello( OTEE, pk_ltk, n_1 ) @ #j) ∧
  (OTEESession( OTEE, u ) @ #j)
 ∧
  #i < #j"
*/
simplify
solve( OTEESession( $OTEE, u.2 ) @ #i )
  case OTEE_Challenge_Response
  solve( OTEESession( $OTEE, ~u ) @ #j )
    case OTEE_Receive_Server_Hello
    solve( OTEE_0( ~tee_id.1, $OTEE, 'g', 'g2', $D.1, ~u, n_0.1, ~x_0.1,
                   X_00.1, pk(x)
           ) ▶₀ #j )
      case OTEE_Client_Hello
      solve( OTEE_3( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1,
                     X_11, DHE, srv_pk, ch_pos, ~ch_prop, int_indicator
             ) ▶₀ #i )
        case Continue_OTEE_Interrupt_With_Agent_case_1
        by contradiction /* cyclic */
      next
        case Continue_OTEE_Interrupt_With_Agent_case_2
        by contradiction /* cyclic */
      next
        case No_Interrupt_OTEE_Memory_Read_case_1
        by contradiction /* cyclic */
      next
        case No_Interrupt_OTEE_Memory_Read_case_2
        by contradiction /* cyclic */
      next
        case No_Interrupt_Prepared_Memory_Read
        by contradiction /* cyclic */
      qed
    qed
  qed
qed

lemma auto_adversaryCannotKnowEnclaveShareBeforeReveal [reuse]:
  all-traces
  "∀ OTEE key #i #j.
    (((OTEERevealSecretKey( OTEE, key ) @ #i) ∧ (!KU( key ) @ #j)) ∧
     (#j < #i)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ OTEE key #i #j.
  (OTEERevealSecretKey( OTEE, key ) @ #i) ∧ (!KU( key ) @ #j) ∧ #j < #i"
*/
simplify
solve( OTEE_3( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1,
               X_11, DHE, srv_pk, ch_pos, ~ch_prop, int_indicator
       ) ▶₀ #i )
  case Continue_OTEE_Interrupt_With_Agent_case_1
  solve( !OTEE_Ltk( $OTEE, ~OTEE_ltk ) ▶₁ #i )
    case NP_Register_OTEE_On_Device
    solve( !KU( ~x_0 ) @ #j )
      case OTEE_Challenge_Response
      by contradiction /* cyclic */
    qed
  qed
next
  case Continue_OTEE_Interrupt_With_Agent_case_2
  solve( !OTEE_Ltk( $OTEE, ~OTEE_ltk ) ▶₁ #i )
    case NP_Register_OTEE_On_Device
    solve( !KU( ~x_0 ) @ #j )
      case OTEE_Challenge_Response
      by contradiction /* cyclic */
    qed
  qed
next
  case No_Interrupt_OTEE_Memory_Read_case_1
  solve( !OTEE_Ltk( $OTEE, ~OTEE_ltk ) ▶₁ #i )
    case NP_Register_OTEE_On_Device
    solve( !KU( ~x_0 ) @ #j )
      case OTEE_Challenge_Response
      by contradiction /* cyclic */
    qed
  qed
next
  case No_Interrupt_OTEE_Memory_Read_case_2
  solve( !OTEE_Ltk( $OTEE, ~OTEE_ltk ) ▶₁ #i )
    case NP_Register_OTEE_On_Device
    solve( !KU( ~x_0 ) @ #j )
      case OTEE_Challenge_Response
      by contradiction /* cyclic */
    qed
  qed
next
  case No_Interrupt_Prepared_Memory_Read
  solve( !OTEE_Ltk( $OTEE, ~OTEE_ltk ) ▶₁ #i )
    case NP_Register_OTEE_On_Device
    solve( !KU( ~x_0 ) @ #j )
      case OTEE_Challenge_Response
      by contradiction /* cyclic */
    qed
  qed
qed

lemma auto_adversaryKnowsOTEEDHSecretAfterReveal [reuse]:
  all-traces
  "∀ OTEE D x_0 x_0_inv X_00 u #i #j.
    (((OTEEHelloDH( OTEE, D, x_0, x_0_inv, X_00 ) @ #i) ∧
      (OTEESession( OTEE, u ) @ #i)) ∧
     (!KU( x_0 ) @ #j)) ⇒
    (∃ #k.
      ((OTEEChallengeResponseDH( OTEE, x_0 ) @ #k) ∧
       (OTEESession( OTEE, u ) @ #k)) ∧
      (#k < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ OTEE D x_0 x_0_inv X_00 u #i #j.
  (OTEEHelloDH( OTEE, D, x_0, x_0_inv, X_00 ) @ #i) ∧
  (OTEESession( OTEE, u ) @ #i) ∧
  (!KU( x_0 ) @ #j)
 ∧
  ∀ #k.
   (OTEEChallengeResponseDH( OTEE, x_0 ) @ #k) ∧
   (OTEESession( OTEE, u ) @ #k)
  ⇒
   ¬(#k < #j)"
*/
simplify
solve( !KU( ~x_0 ) @ #j )
  case OTEE_Challenge_Response_case_1
  solve( OTEESession( $OTEE, u.1 ) @ #i )
    case OTEE_Client_Hello
    by contradiction /* from formulas */
  qed
next
  case OTEE_Challenge_Response_case_2
  solve( OTEESession( $OTEE, u.1 ) @ #i )
    case OTEE_Client_Hello
    by contradiction /* from formulas */
  qed
next
  case OTEE_Challenge_Response_case_3
  solve( OTEESession( $OTEE, u.1 ) @ #i )
    case OTEE_Client_Hello
    by contradiction /* from formulas */
  qed
next
  case OTEE_Challenge_Response_case_4
  solve( OTEESession( $OTEE, u.1 ) @ #i )
    case OTEE_Client_Hello
    by contradiction /* from formulas */
  qed
next
  case OTEE_Challenge_Response_case_5
  solve( OTEESession( $OTEE, u.1 ) @ #i )
    case OTEE_Client_Hello
    by contradiction /* from formulas */
  qed
qed

lemma auto_adversaryCannotLearnDeviceDHShareBeforeEnd [reuse]:
  all-traces
  "∀ OTEE D x_0 x_0_inv X_00 #i #j.
    ((OTEEHelloDH( OTEE, D, x_0, x_0_inv, X_00 ) @ #i) ∧ (!KU( x_0 ) @ #j)) ⇒
    (∃ x_0_inv.1 X_11 #k.
      (OTEEDH( OTEE, x_0, x_0_inv.1, X_11 ) @ #k) ∧ (#k < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ OTEE D x_0 x_0_inv X_00 #i #j.
  (OTEEHelloDH( OTEE, D, x_0, x_0_inv, X_00 ) @ #i) ∧ (!KU( x_0 ) @ #j)
 ∧
  ∀ x_0_inv.1 X_11 #k.
   (OTEEDH( OTEE, x_0, x_0_inv.1, X_11 ) @ #k) ⇒ ¬(#k < #j)"
*/
simplify
solve( OTEE_3( ~tee_id.1, $OTEE, 'g', 'g2', $D.1, ~u.1, n_0, ~x_0, X_00,
               n_1, X_11, DHE, srv_pk, ch_pos, ~ch_prop, int_indicator
       ) ▶₀ #k )
  case Continue_OTEE_Interrupt_With_Agent_case_1
  by contradiction /* from formulas */
next
  case Continue_OTEE_Interrupt_With_Agent_case_2
  by contradiction /* from formulas */
next
  case No_Interrupt_OTEE_Memory_Read_case_1
  by contradiction /* from formulas */
next
  case No_Interrupt_OTEE_Memory_Read_case_2
  by contradiction /* from formulas */
next
  case No_Interrupt_Prepared_Memory_Read
  by contradiction /* from formulas */
qed

lemma auto_ifOTEEConnectsToServerThenShareMustBeOutputByTheServer [reuse]:
  all-traces
  "∀ OTEE AGGR_pk n_1 x_0 x_0_inv X_11 AGGR #i #j.
    (((OTEEReceiveServerHello( OTEE, AGGR_pk, n_1 ) @ #i) ∧
      (OTEEDH( OTEE, x_0, x_0_inv, X_11 ) @ #i)) ∧
     (AggressorPK( AGGR, AGGR_pk ) @ #j)) ⇒
    (∃ X_00 x_1 #k. AggrDH( AGGR, X_00, x_1, X_11 ) @ #k)"
/*
guarded formula characterizing all counter-examples:
"∃ OTEE AGGR_pk n_1 x_0 x_0_inv X_11 AGGR #i #j.
  (OTEEReceiveServerHello( OTEE, AGGR_pk, n_1 ) @ #i) ∧
  (OTEEDH( OTEE, x_0, x_0_inv, X_11 ) @ #i) ∧
  (AggressorPK( AGGR, AGGR_pk ) @ #j)
 ∧
  ∀ X_00 x_1 #k. (AggrDH( AGGR, X_00, x_1, X_11 ) @ #k) ⇒ ⊥"
*/
simplify
solve( !KU( senc(sign(<<n_0, X_00, add('g2'^~e1, z), 'g'^~x_1>,
                       h3(<n_0, X_00, add('g2'^~e1, z), 'g'^~x_1>)>,
                      ~ltk),
                 derive_secret('g'^(~x*~x.1), 's_hs_traffic'))
       ) @ #vk.5 )
  case Server_Hello_case_1
  by contradiction /* from formulas */
next
  case Server_Hello_case_2
  by contradiction /* from formulas */
next
  case c_senc
  solve( !KU( sign(<<n_0, X_00, add('g2'^~e1, z), 'g'^~x_1>,
                    h3(<n_0, X_00, add('g2'^~e1, z), 'g'^~x_1>)>,
                   ~ltk)
         ) @ #vk.7 )
    case Server_Hello
    by contradiction /* from formulas */
  next
    case c_sign
    by solve( !KU( ~ltk ) @ #vk.11 )
  qed
qed

lemma auto_OTEEServerNonceSource [reuse]:
  all-traces
  "∀ OTEE u n_1 #i.
    (OTEESessionAggrNonce( OTEE, u, n_1 ) @ #i) ⇒
    ((∃ AGGR #j. AggrNonce( AGGR, n_1 ) @ #j) ∨ (∃ #j. !KU( n_1 ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ OTEE u n_1 #i.
  (OTEESessionAggrNonce( OTEE, u, n_1 ) @ #i)
 ∧
  (∀ AGGR #j. (AggrNonce( AGGR, n_1 ) @ #j) ⇒ ⊥) ∧
  (∀ #j. (!KU( n_1 ) @ #j) ⇒ ⊥)"
*/
simplify
solve( OTEESessionAggrNonce( OTEE, u, n_1 ) @ #i )
  case Continue_OTEE_Interrupt_With_Agent
  solve( OTEE_Interrupt( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0,
                         X_00, n_1, X_11, DHE, srv_pk
         ) ▶₀ #i )
    case Interrupt_OTEE_Memory_Read
    by contradiction /* from formulas */
  qed
next
  case Interrupt_OTEE_Memory_Read
  solve( OTEE_2( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1,
                 X_11, DHE, srv_pk
         ) ▶₀ #i )
    case OTEE_Receive_Server_Hello
    by contradiction /* from formulas */
  qed
next
  case No_Interrupt_OTEE_Memory_Read
  solve( OTEE_2( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1,
                 X_11, DHE, srv_pk
         ) ▶₀ #i )
    case OTEE_Receive_Server_Hello
    by contradiction /* from formulas */
  qed
next
  case No_Interrupt_Prepared_Memory_Read
  solve( OTEE_2( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1,
                 X_11, DHE, srv_pk
         ) ▶₀ #i )
    case OTEE_Receive_Server_Hello
    by contradiction /* from formulas */
  qed
next
  case OTEE_Challenge_Response
  solve( splitEqs(0) )
    case split_case_1
    by contradiction /* from formulas */
  next
    case split_case_2
    solve( OTEE_3( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1,
                   X_11, DHE, srv_pk, ch_pos, ~ch_prop, int_indicator
           ) ▶₀ #i )
      case Continue_OTEE_Interrupt_With_Agent_case_1
      by contradiction /* from formulas */
    next
      case Continue_OTEE_Interrupt_With_Agent_case_2
      by contradiction /* from formulas */
    next
      case No_Interrupt_OTEE_Memory_Read_case_1
      by contradiction /* from formulas */
    next
      case No_Interrupt_OTEE_Memory_Read_case_2
      by contradiction /* from formulas */
    next
      case No_Interrupt_Prepared_Memory_Read
      by contradiction /* from formulas */
    qed
  next
    case split_case_3
    by solve( OTEE_3( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00,
                      add(z^inv(~t), 'g2'^(~u*h2(int_indicator, measure(ch_pos, ~ch_prop)))),
                      X_11, DHE, srv_pk, ch_pos, ~ch_prop, int_indicator
              ) ▶₀ #i )
  next
    case split_case_4
    solve( OTEE_3( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00,
                   add(x, 'g2'^(~u*h2(int_indicator, measure(ch_pos, ~ch_prop)))), X_11,
                   DHE, srv_pk, ch_pos, ~ch_prop, int_indicator
           ) ▶₀ #i )
      case Continue_OTEE_Interrupt_With_Agent_case_1
      by contradiction /* non-normal terms */
    next
      case Continue_OTEE_Interrupt_With_Agent_case_2
      by contradiction /* non-normal terms */
    next
      case No_Interrupt_OTEE_Memory_Read_case_1
      by contradiction /* non-normal terms */
    next
      case No_Interrupt_OTEE_Memory_Read_case_2
      by contradiction /* non-normal terms */
    next
      case No_Interrupt_Prepared_Memory_Read
      by contradiction /* non-normal terms */
    qed
  next
    case split_case_5
    solve( OTEE_3( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00,
                   add(x^x.1, 'g2'^(~u*h2(int_indicator, measure(ch_pos, ~ch_prop)))), X_11,
                   DHE, srv_pk, ch_pos, ~ch_prop, int_indicator
           ) ▶₀ #i )
      case Continue_OTEE_Interrupt_With_Agent_case_1
      by contradiction /* from formulas */
    next
      case Continue_OTEE_Interrupt_With_Agent_case_2
      by contradiction /* from formulas */
    next
      case No_Interrupt_OTEE_Memory_Read_case_1
      by contradiction /* from formulas */
    next
      case No_Interrupt_OTEE_Memory_Read_case_2
      by contradiction /* from formulas */
    next
      case No_Interrupt_Prepared_Memory_Read
      by contradiction /* from formulas */
    qed
  next
    case split_case_6
    by solve( OTEE_3( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00,
                      add(x^inv((~t*x.1)),
                          'g2'^(~u*h2(int_indicator, measure(ch_pos, ~ch_prop)))),
                      X_11, DHE, srv_pk, ch_pos, ~ch_prop, int_indicator
              ) ▶₀ #i )
  next
    case split_case_7
    by solve( OTEE_3( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00,
                      add(x^(x.1*inv(~t)),
                          'g2'^(~u*h2(int_indicator, measure(ch_pos, ~ch_prop)))),
                      X_11, DHE, srv_pk, ch_pos, ~ch_prop, int_indicator
              ) ▶₀ #i )
  next
    case split_case_8
    by solve( OTEE_3( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00,
                      add(x^(x.1*inv((~t*x.2))),
                          'g2'^(~u*h2(int_indicator, measure(ch_pos, ~ch_prop)))),
                      X_11, DHE, srv_pk, ch_pos, ~ch_prop, int_indicator
              ) ▶₀ #i )
  qed
next
  case OTEE_Receive_Server_Hello
  by contradiction /* from formulas */
qed

