lemma executable:
  exists-trace
  "∃ AGGR OTEE A prop NP #i #j.
    ((AcceptVerificationWithAgent( AGGR, OTEE, A, prop ) @ #i) ∧
     (InitializeNP( NP ) @ #j)) ∧
    (∀ NP2 #j2. (InitializeNP( NP2 ) @ #j2) ⇒ (#j = #j2))"
/*
guarded formula characterizing all satisfying traces:
"∃ AGGR OTEE A prop NP #i #j.
  (AcceptVerificationWithAgent( AGGR, OTEE, A, prop ) @ #i) ∧
  (InitializeNP( NP ) @ #j)
 ∧
  ∀ NP2 #j2. (InitializeNP( NP2 ) @ #j2) ⇒ #j = #j2"
*/
simplify
solve( Aggressor_1( $AGGR, 'g', 'g2', ~prop, ~s, $A, ~ltk, n_0, X_00,
                    n_1, ~x_1, X_11, DHE
       ) ▶₀ #i )
  case Server_Hello
  solve( !NP_Pk( $NP, pk(x.1) ) ▶₂ #i )
    case NP_Init
    solve( !KU( sign(<$otee_id, pk(~OTEE)>, ~ltk.1) ) @ #vk.6 )
      case NP_Register_OTEE_On_Device
      solve( !KU( senc(hmac(derive_secret(derive_secret('g'^(~x*~x_1),
                                                        'c_hs_traffic'),
                                          'finished'),
                            <<n_0, 'g'^~x, add('g2'^~s, z), 'g'^~x_1, pk(~ltk)>,
                             h3(<n_0, 'g'^~x, add('g2'^~s, z), 'g'^~x_1, pk(~ltk)>)>),
                       derive_secret('g'^(~x*~x_1), 'c_hs_traffic'))
             ) @ #vk.2 )
        case OTEE_Challenge_Response_case_01
        solve( !KU( senc(<z, z.1,
                          sign(<z, z.1, $otee_id,
                                hmac(derive_secret(derive_secret('g'^(~x*~x_1), 'c_hs_traffic'),
                                                   'finished'),
                                     <
                                      <'g2'^~u, 'g'^~x,
                                       add('g2'^~s,
                                           'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~prop)))),
                                       'g'^~x_1, pk(~ltk)>,
                                      h3(<'g2'^~u, 'g'^~x,
                                          add('g2'^~s,
                                              'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~prop)))),
                                          'g'^~x_1, pk(~ltk)>)
                                     >)
                               >,
                               ~OTEE),
                          $otee_id>,
                         derive_secret(derive_secret('g'^(~x*~x_1), 'derived'), 'c_ap_traffic'))
               ) @ #vk.5 )
          case OTEE_Challenge_Response_case_1
          solve( !KU( senc(sign(<
                                 <'g2'^~u, 'g'^~x,
                                  add('g2'^~s,
                                      'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~ch_prop)))),
                                  'g'^~x_1>,
                                 h3(<'g2'^~u, 'g'^~x,
                                     add('g2'^~s,
                                         'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~ch_prop)))),
                                     'g'^~x_1>)
                                >,
                                ~ltk),
                           derive_secret('g'^(~x*~x_1), 's_hs_traffic'))
                 ) @ #vk.15 )
            case Server_Hello
            solve( !KU( senc(hmac(derive_secret(derive_secret('g'^(~x*~x_1),
                                                              's_hs_traffic'),
                                                'finished'),
                                  <
                                   <'g2'^~u, 'g'^~x,
                                    add('g2'^~s,
                                        'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~ch_prop)))),
                                    'g'^~x_1>,
                                   sign(<
                                         <'g2'^~u, 'g'^~x,
                                          add('g2'^~s,
                                              'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~ch_prop)))),
                                          'g'^~x_1>,
                                         h3(<'g2'^~u, 'g'^~x,
                                             add('g2'^~s,
                                                 'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~ch_prop))
                                                      )),
                                             'g'^~x_1>)
                                        >,
                                        ~ltk)
                                  >),
                             derive_secret('g'^(~x*~x_1), 's_hs_traffic'))
                   ) @ #vk.16 )
              case Server_Hello
              solve( !KU( pk(~OTEE) ) @ #vk.10 )
                case NP_Register_OTEE_On_Device
                solve( !KU( pk(~ltk) ) @ #vk.17 )
                  case Aggressor_Init
