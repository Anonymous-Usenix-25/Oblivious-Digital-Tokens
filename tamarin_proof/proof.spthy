lemma auto_twoAggrCannotHaveSameDHE [reuse]:
  all-traces
  "∀ AGGR AGGR2 DHE #i #j.
    (((AggrDHKey( AGGR, DHE ) @ #i) ∧ (AggrDHKey( AGGR2, DHE ) @ #j)) ∧
     (¬(#i = #j))) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ AGGR AGGR2 DHE #i #j.
  (AggrDHKey( AGGR, DHE ) @ #i) ∧ (AggrDHKey( AGGR2, DHE ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
  case 1
  by contradiction /* from formulas */
next
  case 2
  solve( splitEqs(0) )
    case split_case_1
    by contradiction /* from formulas */
  next
    case split_case_2
    by contradiction /* from formulas */
  next
    case split_case_3
    solve( splitEqs(1) )
      case split_case_1
      by contradiction /* from formulas */
    next
      case split_case_2
      by contradiction /* from formulas */
    next
      case split_case_3
      solve( (#i < #j)  ∥ (#j < #i) )
        case case_1
