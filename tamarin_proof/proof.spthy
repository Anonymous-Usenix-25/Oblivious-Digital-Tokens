                            qed
                          next
                            case c_exp
                            by sorry
                          qed
                        next
                          case case_2
                          by sorry
                        qed
                      next
                        case c_exp
                        by contradiction
                      qed
                    next
                      case c_add
                      by sorry
                    qed
                  next
                    case c_exp
                    by contradiction
                  qed
                next
                  case c_pk
                  by contradiction
                qed
              next
                case c_pk
                by contradiction
              qed
            next
