lemma auto_ifServerAndOTEEDeriveSameKeyTheAdversaryCannotLearnServerHandshakeSecret [reuse]:
  all-traces
  "∀ AGGR OTEE DHE key #i #j #k.
    (((((AggrDHKey( AGGR, DHE ) @ #i) ∧ (OTEEDHKey( OTEE, DHE ) @ #j)) ∧
       (OTEEServerHandshakeKey( key ) @ #j)) ∧
      (!KU( key ) @ #k)) ∧
     (#k < #j)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ AGGR OTEE DHE key #i #j #k.
  (AggrDHKey( AGGR, DHE ) @ #i) ∧
  (OTEEDHKey( OTEE, DHE ) @ #j) ∧
  (OTEEServerHandshakeKey( key ) @ #j) ∧
  (!KU( key ) @ #k)
 ∧
  #k < #j"
*/
simplify
  case 1
  solve( splitEqs(0) )
    case split_case_1
    by contradiction /* from formulas */
  next
    case split_case_2
    by contradiction /* from formulas */
  next
    case split_case_3
    solve( splitEqs(1) )
      case split_case_01
      by solve( OTEE_0( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~u, X_00, pk(x)
                ) ▶₀ #j )
    next
      case split_case_02
      by contradiction /* from formulas */
    next
      case split_case_03
      by solve( OTEE_0( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~u, X_00, pk(x)
                ) ▶₀ #j )
    next
      case split_case_04
