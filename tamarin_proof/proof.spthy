lemma auto_binding_integrity:
  all-traces
  "∀ AGGR OTEE A prop #i.
    (AcceptVerificationWithAgent( AGGR, OTEE, A, prop ) @ #i) ⇒
    (∃ NP D DHE #j #k #l #m #n.
      ((((OTEERegisteredOnDevice( NP, OTEE, D ) @ #j) ∧
         (OTEEHonestPropertyRead( OTEE, D, A, prop ) @ #k)) ∧
        (AggressorCreateAgent( AGGR, A, prop ) @ #l)) ∧
       (AggrDHKey( AGGR, DHE ) @ #m)) ∧
      (OTEEDHKey( OTEE, DHE ) @ #n))"
/*
guarded formula characterizing all counter-examples:
"∃ AGGR OTEE A prop #i.
  (AcceptVerificationWithAgent( AGGR, OTEE, A, prop ) @ #i)
 ∧
  ∀ NP D DHE #j #k #l #m #n.
   (OTEERegisteredOnDevice( NP, OTEE, D ) @ #j) ∧
   (OTEEHonestPropertyRead( OTEE, D, A, prop ) @ #k) ∧
   (AggressorCreateAgent( AGGR, A, prop ) @ #l) ∧
   (AggrDHKey( AGGR, DHE ) @ #m) ∧
   (OTEEDHKey( OTEE, DHE ) @ #n)
  ⇒
   ⊥"
*/
simplify
solve( Aggressor_1( $AGGR, 'g', 'g2', ~prop, ~s, $A, ~ltk, n_0, X_00,
                    n_1, ~x_1, X_11, DHE
       ) ▶₀ #i )
  case Server_Hello
  solve( !NP_Pk( $NP, pk(x.1) ) ▶₂ #i )
    case NP_Init
    solve( !KU( senc(<z.1, z.2,
                      sign(<z.1, z.2, $otee_id,
                            hmac(derive_secret(derive_secret('g'^(~x*~x_1), 'c_hs_traffic'),
                                               'finished'),
                                 <<n_0, 'g'^~x, add('g2'^~s, z), 'g'^~x_1, pk(~ltk)>,
                                  h3(<n_0, 'g'^~x, add('g2'^~s, z), 'g'^~x_1, pk(~ltk)>)>)
                           >,
                           ~OTEE),
                      $otee_id>,
                     derive_secret(derive_secret('g'^(~x*~x_1), 'derived'), 'c_ap_traffic'))
           ) @ #vk.3 )
      case OTEE_Challenge_Response_case_1
      by contradiction /* from formulas */
    next
      case OTEE_Challenge_Response_case_2
      by contradiction /* from formulas */
    next
      case OTEE_Challenge_Response_case_3
      by contradiction /* from formulas */
    next
      case OTEE_Challenge_Response_case_4
      by contradiction /* from formulas */
    next
      case OTEE_Challenge_Response_case_5
      solve( !KU( pk(~OTEE) ) @ #vk.5 )
        case NP_Register_OTEE_On_Device
        solve( !KU( sign(<$otee_id, pk(~OTEE)>, ~NP_ltk) ) @ #vk.6 )
          case NP_Register_OTEE_On_Device
          solve( splitEqs(3) )
            case split
            solve( !KU( senc(hmac(derive_secret(derive_secret('g'^(~x*~x_1),
                                                              'c_hs_traffic'),
                                                'finished'),
                                  <
                                   <'g2'^~u, 'g'^~x,
                                    add('g2'^~s,
                                        'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~ch_prop)))),
                                    'g'^~x_1, pk(~ltk)>,
                                   h3(<'g2'^~u, 'g'^~x,
                                       add('g2'^~s,
                                           'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~ch_prop)))),
                                       'g'^~x_1, pk(~ltk)>)
                                  >),
                             derive_secret('g'^(~x*~x_1), 'c_hs_traffic'))
                   ) @ #vk.6 )
              case OTEE_Challenge_Response
              solve( !KU( senc(hmac(derive_secret(derive_secret('g'^(~x*~x_1),
                                                                's_hs_traffic'),
                                                  'finished'),
                                    <
                                     <'g2'^~u, 'g'^~x,
                                      add('g2'^~s,
                                          'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~ch_prop)))),
                                      'g'^~x_1>,
                                     sign(<
                                           <'g2'^~u, 'g'^~x,
                                            add('g2'^~s,
                                                'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~ch_prop)))),
                                            'g'^~x_1>,
                                           h3(<'g2'^~u, 'g'^~x,
                                               add('g2'^~s,
                                                   'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~ch_prop))
                                                        )),
                                               'g'^~x_1>)
                                          >,
                                          ~ltk)
                                    >),
                               derive_secret('g'^(~x*~x_1), 's_hs_traffic'))
                     ) @ #vk.17 )
                case Server_Hello
                by solve( !KU( ~ch_prop ) @ #vk.11 )
              next
                case c_senc
                by solve( !KU( ~ch_prop ) @ #vk.11 )
              qed
            next
              case c_senc
              solve( !KU( senc(hmac(derive_secret(derive_secret('g'^(~x*~x_1),
                                                                's_hs_traffic'),
                                                  'finished'),
                                    <
                                     <'g2'^~u, 'g'^~x,
                                      add('g2'^~s,
                                          'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~ch_prop)))),
                                      'g'^~x_1>,
                                     sign(<
                                           <'g2'^~u, 'g'^~x,
                                            add('g2'^~s,
                                                'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~ch_prop)))),
                                            'g'^~x_1>,
                                           h3(<'g2'^~u, 'g'^~x,
                                               add('g2'^~s,
                                                   'g2'^(~u*h2('0', measure(select('g'^(~x*~x_1)), ~ch_prop))
                                                        )),
                                               'g'^~x_1>)
                                          >,
                                          ~ltk)
                                    >),
                               derive_secret('g'^(~x*~x_1), 's_hs_traffic'))
                     ) @ #vk.17 )
                case Server_Hello
                by solve( !KU( ~ch_prop ) @ #vk.11 )
              next
                case c_senc
                by solve( !KU( ~ch_prop ) @ #vk.11 )
              qed
            qed
          qed
