lemma auto_ifServerAndOTEEDeriveSameKeyTheAdversaryCannotLearnClientHandshakeSecret [reuse]:
  all-traces
  "∀ AGGR OTEE DHE key #i #j #k.
    (((((AggrDHKey( AGGR, DHE ) @ #i) ∧
        (AggrClientHandshakeKey( key ) @ #i)) ∧
       (OTEEDHKey( OTEE, DHE ) @ #j)) ∧
      (!KU( key ) @ #k)) ∧
     (#k < #i)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ AGGR OTEE DHE key #i #j #k.
