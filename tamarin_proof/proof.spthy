                                       add('g2'^~e1,
                                           'g2'^(~u*h2('0', measure(select('g'^(~x*~x_0)), ~prop)))),
                                       'g'^~x>)
                                  >,
                                  ~ltk)
                            >),
                       derive_secret('g'^(~x*~x_0), 's_hs_traffic'))
             ) @ #vk.6 )
        case Server_Hello
        by solve( splitEqs(0) )
      next
