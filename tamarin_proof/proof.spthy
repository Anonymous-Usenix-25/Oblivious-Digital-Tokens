theory ODT begin

// Function signature and definition of the equational theory E

builtins: diffie-hellman
functions: add/2, adec/2, aenc/2, derive_secret/2, fst/1, h/1, h2/2,
           h3/1, hmac/2, measure/2, pair/2, pk/1, read/2, sdec/2, select/1, senc/2,
           sign/2, snd/1, sub/2, true/0, verify/3
equations [convergent]:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    measure(pos, read(pos, prop)) = measure(pos, prop),
    read(pos, read(pos, prop)) = read(pos, prop),
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2,
    sub(add(x, y), y) = x,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true



heuristic: o "myoracle.py"



macros:
    calculate_witness( int_indicator, ch_pos,
                       ch_prop ) = h2(int_indicator,measure(ch_pos,ch_prop)),
    calculate_server_nonce( g2, s, client_nonce,
                            w ) = add(exp(g2,s),exp(client_nonce,w)),
    calculate_y( g2, t ) = exp(g2,t),
    calculate_z( g2, u, t, w,
                 server_nonce ) = exp(sub(server_nonce,exp(exp(g2,u),w)),t),
    client_ODT_signature_payload( y, z, OTEE_id,
                                  client_finished ) = pair(y,pair(z,pair(OTEE_id,client_finished))),
    client_ODT_response_payload( y, z, signature,
                                 OTEE_id ) = pair(y,pair(z,pair(signature,OTEE_id))),
    server_handshake_traffic_secret( DHE ) = derive_secret(DHE,'s_hs_traffic'),
    client_handshake_traffic_secret( DHE ) = derive_secret(DHE,'c_hs_traffic'),
    server_finished_key( DHE ) = derive_secret(server_handshake_traffic_secret(DHE),'finished'),
    client_finished_key( DHE ) = derive_secret(client_handshake_traffic_secret(DHE),'finished'),
    master_secret( DHE ) = derive_secret(DHE,'derived'),
    client_application_traffic_secret( DHE ) = derive_secret(master_secret(DHE),'c_ap_traffic'),
    server_transcript( client_nonce, client_DHE, server_nonce,
                       server_DHE ) = pair(client_nonce,pair(client_DHE,pair(server_nonce,server_DHE))),
    server_transcript_hash( client_nonce, client_DHE, server_nonce,
                            server_DHE ) = h3(server_transcript(client_nonce,client_DHE,server_nonce,server_DHE)),
    server_certificate_verify_ext( client_nonce, client_DHE, server_nonce,
                                   server_DHE ) = pair(server_transcript(client_nonce,client_DHE,server_nonce,server_DHE),server_transcript_hash(client_nonce,client_DHE,server_nonce,server_DHE)),
    server_certificate_verify_ext_signed( client_nonce, client_DHE,
                                          server_nonce, server_DHE,
                                          server_ltk ) = sign(server_certificate_verify_ext(client_nonce,client_DHE,server_nonce,server_DHE),server_ltk),
    server_finished( server_certificate_verify_ext_signed, client_nonce,
                     client_DHE, server_nonce, server_DHE, server_ltk,
                     DHE ) = hmac(server_finished_key(DHE),pair(server_transcript(client_nonce,client_DHE,server_nonce,server_DHE),server_certificate_verify_ext_signed)),
    create_encrypted_server_certificate_ext_signed( client_nonce, client_DHE,
                                                    server_nonce, server_DHE, server_ltk,
                                                    DHE ) = senc(server_certificate_verify_ext_signed(client_nonce,client_DHE,server_nonce,server_DHE,server_ltk),server_handshake_traffic_secret(DHE)),
    create_encrypted_server_finished( client_nonce, client_DHE, server_nonce,
                                      server_DHE, server_ltk,
                                      DHE ) = senc(server_finished(server_certificate_verify_ext_signed(client_nonce,client_DHE,server_nonce,server_DHE,server_ltk),client_nonce,client_DHE,server_nonce,server_DHE,server_ltk,DHE),server_handshake_traffic_secret(DHE)),
    client_transcript( client_nonce, client_DHE, server_nonce, server_DHE,
                       server_pk ) = pair(client_nonce,pair(client_DHE,pair(server_nonce,pair(server_DHE,server_pk)))),
    client_transcript_hash( client_nonce, client_DHE, server_nonce,
                            server_DHE,
                            server_pk ) = h3(client_transcript(client_nonce,client_DHE,server_nonce,server_DHE,server_pk)),
    calc_client_finished( client_nonce, client_DHE, server_nonce, server_DHE,
                          server_pk,
                          DHE ) = hmac(client_finished_key(DHE),pair(client_transcript(client_nonce,client_DHE,server_nonce,server_DHE,server_pk),client_transcript_hash(client_nonce,client_DHE,server_nonce,server_DHE,server_pk)))

rule (modulo E) NP_Init:
   [ Fr( ~ltk ) ]
  --[ InitializeNP( $NP ), InitializeNP_LTK( $NP, ~ltk ) ]->
   [ !NP_Ltk( $NP, ~ltk ), !NP_Pk( $NP, pk(~ltk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Device_Init:
   [ ] --> [ !Device( $D ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) NP_Register_OTEE_On_Device:
   [ !Device( $D ), !NP_Ltk( $NP, ~NP_ltk ), Fr( ~OTEE_ltk ) ]
  --[
  OTEERegisteredOnDevice( $NP, $OTEE, $D ), Unique( <$NP, $D> ),
  Unique( $OTEE ), OTEERegisterOTEE( $NP, $OTEE, ~OTEE_ltk )
  ]->
   [
   !OTEE_Ltk( $OTEE, ~OTEE_ltk ), !OTEE_Pk( $OTEE, pk(~OTEE_ltk) ),
   !OTEE( $OTEE, $D ),
   Out( <$OTEE, pk(~OTEE_ltk), sign(<$OTEE, pk(~OTEE_ltk)>, ~NP_ltk)> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Aggressor_Init:
   [ Fr( ~ltk ) ]
  --[
  AggressorInitialized( $AGGR ), AggressorLTK( $AGGR, ~ltk ),
  AggressorPK( $AGGR, pk(~ltk) )
  ]->
   [ !AGGR_Ltk( $AGGR, ~ltk ), !AGGR_Pk( $AGGR, pk(~ltk) ), Out( pk(~ltk) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Aggressor_Create_Agent:
   [ !AGGR_Ltk( $AGGR, ~ltk ), Fr( ~prop ) ]
  --[ AggressorCreateAgent( $AGGR, $A, ~prop ) ]->
   [ Aggressor_0( $AGGR, ~prop, $A, ~ltk ), !Agent( $A, ~prop ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Adversary_Create_Agent:
   [ In( ~prop ) ]
  --[ AdversaryCreateAgent( $A, ~prop ) ]->
   [ !Agent( $A, ~prop ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Adversary_Extract_Agent_Properties:
   [ !Agent( $A, ~prop ), In( positions ) ]
  --[ AdversaryExtractAgentProperties( $A, ~prop ) ]->
   [ Out( read(positions, ~prop) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Device_Run_Agent:
   [ !Device( $D ), !Agent( $A, ~prop ), Fr( ~aid ) ]
  --[ DeviceStartRunningAgent( ~aid, $A, $D ) ]->
   [ !AgentInstance( ~aid, $A, $D, ~prop ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) OTEE_Client_Hello[derivchecks]:
   [ !OTEE( $OTEE, $D ), In( pk(~ltk) ), Fr( ~u ), Fr( ~x_0 ), Fr( ~tee_id )
   ]
  --[
  OTEEStartThread( ~tee_id ), OTEEHello( $OTEE, $D, ~u ),
  OTEEHelloDH( $OTEE, $D, ~x_0, inv(~x_0), 'g'^~x_0 ),
  ImpossibleBeforeXCH( ~x_0 ), ImpossibleBeforeXCH( inv(~x_0) ),
  ImpossibleBeforeXCH( 'g'^~x_0 ),
  OTEEHelloU( $OTEE, ~u, inv(~u), 'g2'^~u ), ImpossibleBeforeUCH( ~u ),
  ImpossibleBeforeUCH( inv(~u) ), ImpossibleBeforeUCH( 'g2'^~u ),
  OTEESession( $OTEE, ~u )
  ]->
   [
   OTEE_0( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, 'g2'^~u, ~x_0, 'g'^~x_0,
           pk(~ltk)
   ),
   Out( <'g2'^~u, 'g'^~x_0> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Server_Hello[derivchecks]:
   [
   Aggressor_0( $AGGR, ~prop, $A, ~ltk ), In( <'g2'^CN, 'g'^~x_0> ),
   Fr( ~x_1 ), Fr( ~s )
   ]
  --[
  Neq( 'g'^~x_0^~x_1, 'g' ), Neq( 'g'^~x_0^~x_1, DH_neutral ),
  Neq( 'g'^~x_0, 'g' ), Neq( 'g'^~x_0, DH_neutral ), Neq( 'g2'^CN, 'g2' ),
  Neq( 'g2'^CN, DH_neutral ),
  Neq( 'g2'^CN^calculate_witness('0', select('g'^~x_0^~x_1), ~prop), 'g2'
  ),
  Neq( 'g2'^CN^calculate_witness('0', select('g'^~x_0^~x_1), ~prop),
       DH_neutral
  ),
  Neq( 'g2'^CN, 'g'^~x_0 ), Neq( 'g2'^CN, 'g'^~x_0^~x_1 ),
  ServerHello( $AGGR, $A ), OUT_Aggressor_0( ~prop ),
  AggrDH( $AGGR, 'g'^~x_0, ~x_1, 'g'^~x_1 ),
  AggrDHKey( $AGGR, 'g'^~x_0^~x_1 ), AggrS( $AGGR, ~s ),
  AggrG2S( $AGGR, 'g2'^~s ),
  AggrNonce( $AGGR,
             calculate_server_nonce('g2', ~s, 'g2'^CN,
                                    calculate_witness('0', select('g'^~x_0^~x_1), ~prop))
  ),
  AggrServerHelloPK( $AGGR, ~ltk, pk(~ltk) ),
  AggrMeasurementSelection( $AGGR, select('g'^~x_0^~x_1) ),
  AggrKeyUsedForEncryption( $AGGR,
                            server_handshake_traffic_secret('g'^~x_0^~x_1)
  ),
  AggrClientHandshakeKey( client_handshake_traffic_secret('g'^~x_0^~x_1) )
  ]->
   [
   Aggressor_1( $AGGR, 'g', 'g2', ~prop, ~s, $A, ~ltk, 'g2'^CN, 'g'^~x_0,
                calculate_server_nonce('g2', ~s, 'g2'^CN,
                                       calculate_witness('0', select('g'^~x_0^~x_1), ~prop)),
                ~x_1, 'g'^~x_1, 'g'^~x_0^~x_1
   ),
   Out( <
         calculate_server_nonce('g2', ~s, 'g2'^CN,
                                calculate_witness('0', select('g'^~x_0^~x_1), ~prop)),
         'g'^~x_1,
         create_encrypted_server_certificate_ext_signed('g2'^CN, 'g'^~x_0,
                                                        calculate_server_nonce('g2', ~s, 'g2'^CN,
                                                                               calculate_witness('0',
                                                                                                 select('g'^~x_0^~x_1),
                                                                                                 ~prop)),
                                                        'g'^~x_1, ~ltk, 'g'^~x_0^~x_1),
         create_encrypted_server_finished('g2'^CN, 'g'^~x_0,
                                          calculate_server_nonce('g2', ~s, 'g2'^CN,
                                                                 calculate_witness('0', select('g'^~x_0^~x_1),
                                                                                   ~prop)),
                                          'g'^~x_1, ~ltk, 'g'^~x_0^~x_1)
        >
   )
   ]

  /*
  rule (modulo AC) Server_Hello[derivchecks]:
     [
     Aggressor_0( $AGGR, ~prop, $A, ~ltk ), In( <z, 'g'^~x> ), Fr( ~x_1 ),
     Fr( ~s )
     ]
    --[
    Neq( 'g'^(~x*~x_1), 'g' ), Neq( 'g'^(~x*~x_1), DH_neutral ),
    Neq( 'g'^~x, 'g' ), Neq( 'g'^~x, DH_neutral ), Neq( z, 'g2' ),
    Neq( z, DH_neutral ), Neq( z.1, 'g2' ), Neq( z.1, DH_neutral ),
    Neq( z, 'g'^~x ), Neq( z, 'g'^(~x*~x_1) ), ServerHello( $AGGR, $A ),
    OUT_Aggressor_0( ~prop ), AggrDH( $AGGR, 'g'^~x, ~x_1, 'g'^~x_1 ),
    AggrDHKey( $AGGR, 'g'^(~x*~x_1) ), AggrS( $AGGR, ~s ),
    AggrG2S( $AGGR, 'g2'^~s ), AggrNonce( $AGGR, add('g2'^~s, z.1) ),
    AggrServerHelloPK( $AGGR, ~ltk, pk(~ltk) ),
    AggrMeasurementSelection( $AGGR, select('g'^(~x*~x_1)) ),
    AggrKeyUsedForEncryption( $AGGR,
                              derive_secret('g'^(~x*~x_1), 's_hs_traffic')
    ),
    AggrClientHandshakeKey( derive_secret('g'^(~x*~x_1), 'c_hs_traffic') )
    ]->
     [
     Aggressor_1( $AGGR, 'g', 'g2', ~prop, ~s, $A, ~ltk, z, 'g'^~x,
                  add('g2'^~s, z.1), ~x_1, 'g'^~x_1, 'g'^(~x*~x_1)
     ),
     Out( <add('g2'^~s, z.1), 'g'^~x_1,
           senc(sign(<<z, 'g'^~x, add('g2'^~s, z.1), 'g'^~x_1>,
                      h3(<z, 'g'^~x, add('g2'^~s, z.1), 'g'^~x_1>)>,
                     ~ltk),
                derive_secret('g'^(~x*~x_1), 's_hs_traffic')),
           senc(hmac(derive_secret(derive_secret('g'^(~x*~x_1), 's_hs_traffic'),
                                   'finished'),
                     <<z, 'g'^~x, add('g2'^~s, z.1), 'g'^~x_1>,
                      sign(<<z, 'g'^~x, add('g2'^~s, z.1), 'g'^~x_1>,
                            h3(<z, 'g'^~x, add('g2'^~s, z.1), 'g'^~x_1>)>,
                           ~ltk)
                     >),
                derive_secret('g'^(~x*~x_1), 's_hs_traffic'))
          >
     )
     ]
    variants (modulo AC)
    1. ~prop = ~prop.42
       ~x    = ~x.60
       ~x_1  = ~x_1.45
       z     = 'g2'
       z.1   = 'g2'^h2('0', measure(select('g'^(~x_1.45*~x.60)), ~prop.42))

    2. ~prop = ~prop.42
       ~x    = ~x.60
       ~x_1  = ~x_1.45
       z     = 'g2'^inv(h2('0', measure(select('g'^(~x_1.45*~x.60)), ~prop.42)))
       z.1   = 'g2'

    3. ~prop = ~prop.579
       ~x    = ~x.597
       ~x_1  = ~x_1.582
       z     = 'g2'^CN.1153
       z.1   = 'g2'^(CN.1153*
                     h2('0', measure(select('g'^(~x_1.582*~x.597)), ~prop.579)))

    4. ~prop = ~prop.583
       ~x    = ~x.601
       ~x_1  = ~x_1.586
       z     = 'g2'^inv((x.1161*
                         h2('0', measure(select('g'^(~x_1.586*~x.601)), ~prop.583))))
       z.1   = 'g2'^inv(x.1161)

    5. ~prop = ~prop.583
       ~x    = ~x.601
       ~x_1  = ~x_1.586
       z     = 'g2'^(x.1161*
                     inv(h2('0', measure(select('g'^(~x_1.586*~x.601)), ~prop.583))))
       z.1   = 'g2'^x.1161

    6. ~prop = ~prop.584
       ~x    = ~x.602
       ~x_1  = ~x_1.587
       z     = 'g2'^(x.1162*
                     inv((x.1163*h2('0', measure(select('g'^(~x_1.587*~x.602)), ~prop.584)))))
       z.1   = 'g2'^(x.1162*inv(x.1163))
  */

rule (modulo E) OTEE_Receive_Server_Hello[derivchecks]:
   [
   OTEE_0( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, srv_pk ),
   In( <add('g2'^~e1, 'g2'^e2), 'g'^~x_1,
        senc(rec_server_certificate_verify_ext_signed,
             server_handshake_traffic_secret('g'^~x_1^~x_0)),
        senc(rec_server_finished, server_handshake_traffic_secret('g'^~x_1^~x_0))
       >
   )
   ]
  --[
  Eq( verify(rec_server_certificate_verify_ext_signed,
             server_certificate_verify_ext(n_0, X_00, add('g2'^~e1, 'g2'^e2),
                                           'g'^~x_1),
             srv_pk),
      true
  ),
  Eq( rec_server_finished,
      server_finished(rec_server_certificate_verify_ext_signed, n_0, X_00,
                      add('g2'^~e1, 'g2'^e2), 'g'^~x_1, srv_pk, 'g'^~x_1^~x_0)
  ),
  Neq( 'g'^~x_1^~x_0, 'g'^one ), Neq( 'g'^~x_1^~x_0, DH_neutral ),
  Neq( 'g'^~x_1^~x_0, 'g'^~x_0 ), Neq( 'g'^~x_1^~x_0, 'g'^~x_1 ),
  Neq( 'g'^~x_1, 'g2'^one ), Neq( 'g'^~x_1, DH_neutral ),
  Neq( 'g'^~x_1, 'g2'^~x_0 ), Neq( 'g2'^~e1^e2, 'g2'^one ),
  Neq( 'g2'^~e1^e2, DH_neutral ), Neq( 'g2'^~e1^e2, 'g'^~x_0 ),
  Neq( 'g2'^~e1^e2, 'g2'^~x_0 ), Neq( 'g2'^~e1^e2, 'g2'^~u ),
  Neq( 'g2'^~e1^e2, 'g2'^~u^~x_0 ), Neq( 'g2'^~e1^e2, 'g'^~x_1^~u ),
  Neq( 'g2'^~e1^e2, 'g'^~x_1^~x_0^~u ), Neq( 'g2'^~e1^e2, 'g'^~x_1 ),
  Neq( 'g2'^~e1^e2, 'g'^~x_1^~x_0 ), Neq( 'g2'^~e1^e2, 'g2'^inv(~u) ),
  Neq( 'g2'^~e1^e2, 'g2'^inv(~u)^~x_0 ),
  Neq( 'g2'^~e1^e2, 'g'^~x_1^inv(~u) ),
  Neq( 'g2'^~e1^e2, 'g'^~x_1^~x_0^inv(~u) ),
  OTEEExponents( $OTEE, ~e1, e2 ),
  OTEEReceiveServerHello( $OTEE, srv_pk, add('g2'^~e1, 'g2'^e2) ),
  OTEEDHKey( $OTEE, 'g'^~x_1^~x_0 ),
  OTEEDH( $OTEE, ~x_0, inv(~x_0), 'g'^~x_1 ), OTEESession( $OTEE, ~u ),
  OTEESessionAggrNonce( $OTEE, ~u, add('g2'^~e1, 'g2'^e2) ),
  PropertyHelper( $OTEE, ~x_1, ~x_0, 'g'^~x_1^~x_0 ),
  OTEEServerHandshakeKey( client_handshake_traffic_secret('g'^~x_1^~x_0) )
  ]->
   [
   OTEE_2( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00,
           add('g2'^~e1, 'g2'^e2), 'g'^~x_1, 'g'^~x_1^~x_0, srv_pk
   )
   ]

  /*
  rule (modulo AC) OTEE_Receive_Server_Hello[derivchecks]:
     [
     OTEE_0( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, srv_pk ),
     In( <add('g2'^~e1, z), 'g'^~x_1,
          senc(rec_server_certificate_verify_ext_signed,
               derive_secret('g'^(~x.1*~x.2), 's_hs_traffic')),
          senc(rec_server_finished, derive_secret('g'^(~x.1*~x.2), 's_hs_traffic'))
         >
     )
     ]
    --[
    Eq( z.1, true ),
    Eq( rec_server_finished,
        hmac(derive_secret(derive_secret('g'^(~x.1*~x.2), 's_hs_traffic'),
                           'finished'),
             <<n_0, X_00, add('g2'^~e1, z), 'g'^~x_1>,
              rec_server_certificate_verify_ext_signed>)
    ),
    Neq( 'g'^(~x.1*~x.2), 'g' ), Neq( 'g'^(~x.1*~x.2), DH_neutral ),
    Neq( 'g'^(~x.1*~x.2), 'g'^~x_0 ), Neq( 'g'^(~x.1*~x.2), 'g'^~x_1 ),
    Neq( 'g'^~x_1, 'g2' ), Neq( 'g'^~x_1, DH_neutral ),
    Neq( 'g'^~x_1, 'g2'^~x_0 ), Neq( z.2, 'g2' ), Neq( z.2, DH_neutral ),
    Neq( z.2, 'g'^~x_0 ), Neq( z.2, 'g2'^~x_0 ), Neq( z.2, 'g2'^~u ),
    Neq( z.2, 'g2'^(~u*~x_0) ), Neq( z.2, 'g'^(~u*~x_1) ),
    Neq( z.2, 'g'^(~u*~x.1*~x.2) ), Neq( z.2, 'g'^~x_1 ),
    Neq( z.2, 'g'^(~x.1*~x.2) ), Neq( z.2, 'g2'^inv(~u) ), Neq( z.2, z.3 ),
    Neq( z.2, z.4 ), Neq( z.2, 'g'^x ), OTEEExponents( $OTEE, ~e1, e2 ),
    OTEEReceiveServerHello( $OTEE, srv_pk, add('g2'^~e1, z) ),
    OTEEDHKey( $OTEE, 'g'^(~x.1*~x.2) ),
    OTEEDH( $OTEE, ~x_0, inv(~x_0), 'g'^~x_1 ), OTEESession( $OTEE, ~u ),
    OTEESessionAggrNonce( $OTEE, ~u, add('g2'^~e1, z) ),
    PropertyHelper( $OTEE, ~x_1, ~x_0, 'g'^(~x.1*~x.2) ),
    OTEEServerHandshakeKey( derive_secret('g'^(~x.1*~x.2), 'c_hs_traffic') )
    ]->
     [
     OTEE_2( ~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00,
             add('g2'^~e1, z), 'g'^~x_1, 'g'^(~x.1*~x.2), srv_pk
     )
     ]
    variants (modulo AC)
     1. ~e1   = ~e1.94
        ~u    = ~u.96
        ~x_0  = ~u.96
        ~x_1  = ~u.96
        X_00  = X_00.99
        e2    = e2.100
        n_0   = n_0.101
        rec_server_certificate_verify_ext_signed
              = rec_server_certificate_verify_ext_signed.102
        srv_pk
              = srv_pk.104
        x     = ~u.96
        z     = 'g2'^e2.100
        ~x.1  = ~u.96
        z.1   = verify(rec_server_certificate_verify_ext_signed.102,
                       <<n_0.101, X_00.99, add('g2'^~e1.94, 'g2'^e2.100), 'g'^~u.96>,
                        h3(<n_0.101, X_00.99, add('g2'^~e1.94, 'g2'^e2.100), 'g'^~u.96>)>,
                       srv_pk.104)
        ~x.2  = ~u.96
        z.2   = 'g2'^(~e1.94*e2.100)
        z.3   = 'g2'
        z.4   = 'g'

     2. ~e1   = ~e1.94
        ~u    = ~u.96
        ~x_0  = ~u.96
