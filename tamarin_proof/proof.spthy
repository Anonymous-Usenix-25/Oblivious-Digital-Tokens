                           'g'^~x>,
                          h3(<'g2'^~u, 'g'^~x_0,
                              add('g2'^~e1, 'g2'^(~u*h2('0', measure(select('g'^(~x*~x_0)), ~prop)))),
                              'g'^~x>)
                         >,
                         ~ltk)
               ) @ #vk.11 )
          case Server_Hello
