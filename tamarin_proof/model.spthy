theory ODT
begin

builtins: hashing, asymmetric-encryption, symmetric-encryption, diffie-hellman, signing
functions: h2/2, h3/1, hmac/2, derive_secret/2, measure/2, select/1, read/2, sub/2, add/2
equations [convergent]: read(pos, read(pos, prop)) = read(pos, prop), measure(pos, read(pos, prop)) = measure(pos, prop), sub(add(x, y), y) = x

// We do not use the equation "sub(add(x, y), x) = y" because 'x =
// g^s' contains the aggressor's secret key 's' that is never output
// or used in the protocol until the very end for verification. In
// general, the 'sub' and 'add' functions are an abstraction of DH
// addition and subtractions in the exponent that is currently not
// supported in Tamarin. In that sense, we restrict the adversary
// somewhat in what it can do in Tamarin, but in the paper we prove
// that our DH addition and substraction work as intendented and never
// leak any information to the adversary.

heuristic: o "myoracle.py"

// Various macros used in the protocol. Note that we abstract the TLS
// protocol to only those messages and features that are necessary for
// the ODT protocol to work.
macros:
  calculate_witness(int_indicator, ch_pos, ch_prop) = h2(int_indicator, measure(ch_pos, ch_prop)),
  calculate_server_nonce(g2, s, client_nonce, w) = add(g2^s, client_nonce^w),
  calculate_y(g2, t) = <g2^t>,
  calculate_z(g2, u, t, w, server_nonce) = <sub(server_nonce, g2^u^w)^t>,

  client_ODT_signature_payload(y, z, OTEE_id, client_finished) = <y, z, OTEE_id, client_finished>,
  client_ODT_response_payload(y, z, signature, OTEE_id) = <y, z, signature, OTEE_id>,

  server_handshake_traffic_secret(DHE) = derive_secret(DHE, 's_hs_traffic'),
  client_handshake_traffic_secret(DHE) = derive_secret(DHE, 'c_hs_traffic'),
  server_finished_key(DHE) = derive_secret(server_handshake_traffic_secret(DHE), 'finished'),
  client_finished_key(DHE) = derive_secret(client_handshake_traffic_secret(DHE), 'finished'),
  master_secret(DHE) = derive_secret(DHE, 'derived'), // Simplified
  client_application_traffic_secret(DHE) = derive_secret(master_secret(DHE), 'c_ap_traffic'),

  server_transcript(client_nonce, client_DHE, server_nonce, server_DHE) = <client_nonce, client_DHE, server_nonce, server_DHE>,
  server_transcript_hash(client_nonce, client_DHE, server_nonce, server_DHE) = h3(server_transcript(client_nonce, client_DHE, server_nonce, server_DHE)),
  server_certificate_verify_ext(client_nonce, client_DHE, server_nonce, server_DHE) = <server_transcript(client_nonce, client_DHE, server_nonce, server_DHE), server_transcript_hash(client_nonce, client_DHE, server_nonce, server_DHE)>,
  server_certificate_verify_ext_signed(client_nonce, client_DHE, server_nonce, server_DHE, server_ltk) = sign(server_certificate_verify_ext(client_nonce, client_DHE, server_nonce, server_DHE), server_ltk),
  // Instead of extending the transcript and hashing it again, we just give it to hmac as a pair directly
  server_finished(server_certificate_verify_ext_signed, client_nonce, client_DHE, server_nonce, server_DHE, server_ltk, DHE) = hmac(server_finished_key(DHE), <server_transcript(client_nonce, client_DHE, server_nonce, server_DHE), server_certificate_verify_ext_signed>),

  create_encrypted_server_certificate_ext_signed(client_nonce, client_DHE, server_nonce, server_DHE, server_ltk, DHE) = senc(server_certificate_verify_ext_signed(client_nonce, client_DHE, server_nonce, server_DHE, server_ltk), server_handshake_traffic_secret(DHE)),
  create_encrypted_server_finished(client_nonce, client_DHE, server_nonce, server_DHE, server_ltk, DHE) = senc(server_finished(server_certificate_verify_ext_signed(client_nonce, client_DHE, server_nonce, server_DHE, server_ltk), client_nonce, client_DHE, server_nonce, server_DHE, server_ltk, DHE), server_handshake_traffic_secret(DHE)),

  client_transcript(client_nonce, client_DHE, server_nonce, server_DHE, server_pk) = <client_nonce, client_DHE, server_nonce, server_DHE, server_pk>,
  client_transcript_hash(client_nonce, client_DHE, server_nonce, server_DHE, server_pk) = h3(client_transcript(client_nonce, client_DHE, server_nonce, server_DHE, server_pk)),
  calc_client_finished(client_nonce, client_DHE, server_nonce, server_DHE, server_pk, DHE) = hmac(client_finished_key(DHE), <client_transcript(client_nonce, client_DHE, server_nonce, server_DHE, server_pk), client_transcript_hash(client_nonce, client_DHE, server_nonce, server_DHE, server_pk)>)


// OTEE - The O-TEE
// NP - Neutral party
// D - Device
// AGGR - Aggressor

//////// Role setup ////////

// Create a neutral party NP
rule NP_Init:
    [ Fr(~ltk)
    ]
  --[ InitializeNP($NP)
    , InitializeNP_LTK($NP, ~ltk) ]->
    [ !NP_Ltk($NP, ~ltk), !NP_Pk($NP, pk(~ltk)) ]

// Initialize a device D
rule Device_Init:
    []
  --[]->
    [ !Device($D) ]

// Neutral organization registers an O-TEE (the prover) on a device D
rule NP_Register_OTEE_On_Device:
    [ !Device($D)
    , !NP_Ltk($NP, ~NP_ltk)
    , Fr(~OTEE_ltk)
    ]
  --[ OTEERegisteredOnDevice($NP, $OTEE, $D)
    , Unique(<$NP, $D>) // A device is only registered once by every neutral party
    , Unique($OTEE) // A specific O-TEE can only be registered once
    , OTEERegisterOTEE($NP, $OTEE, ~OTEE_ltk)
    ]->
    [ !OTEE_Ltk($OTEE, ~OTEE_ltk)
    , !OTEE_Pk($OTEE, pk(~OTEE_ltk))
    , !OTEE($OTEE, $D)
    // Publish O-TEE identity and a NP certificate for the O-TEE's
    // public key
    , Out(<$OTEE, pk(~OTEE_ltk), sign(<$OTEE, pk(~OTEE_ltk)>, ~NP_ltk)>)
    ]

// Initialize a new aggressor AGGR (the verifier)
rule Aggressor_Init:
    [ Fr(~ltk)
    ]
  --[ AggressorInitialized($AGGR)
    , AggressorLTK($AGGR, ~ltk)
    , AggressorPK($AGGR, pk(~ltk)) ]->
    [ !AGGR_Ltk($AGGR, ~ltk)
    , !AGGR_Pk($AGGR, pk(~ltk))
    , Out(pk(~ltk))
    ]

// Aggressor creates a new agent process
rule Aggressor_Create_Agent:
    [ !AGGR_Ltk($AGGR, ~ltk)
    , Fr(~prop) // Properties of the agent
    ]
  --[ AggressorCreateAgent($AGGR, $A, ~prop) ]->
    // The Aggressor_0 is not a persistend fact to represents an
    // aggressor that accepts verification only once for a specific
    // agent.
    [ Aggressor_0($AGGR, ~prop, $A, ~ltk)
    // The agent fact stores the agent's identity and its
    // properties. The agent is a persistent fact because it is a
    // program that can run multiple times.
    , !Agent($A, ~prop)
    ]

// The adversary can create its own agent process
rule Adversary_Create_Agent:
    [ In(~prop) ]
  --[ AdversaryCreateAgent($A, ~prop) ]->
    [ !Agent($A, ~prop) ]

// Adversary that finds out the measured positions can read the
// corresponding properties from an agent. With restrictions, we
// prevent the adversary from extracting properties from its own
// agents. We do this to speed up the proof.
rule Adversary_Extract_Agent_Properties:
    [ !Agent($A, ~prop)
    , In(positions) ]
  --[ AdversaryExtractAgentProperties($A, ~prop) ]->
    [ Out(read(positions, ~prop)) ]

// Device starts running an agent process.
rule Device_Run_Agent:
    [ !Device($D)
    , !Agent($A, ~prop)
    , Fr(~aid) ]
  --[ DeviceStartRunningAgent(~aid, $A, $D) ]->
    [ !AgentInstance(~aid, $A, $D, ~prop) ]


//////// Protocol specification ////////

// OTEE recieves a connection request to the server with public key
// `srv_pk` from the adversary (serving the role of the device) and
// outputs the ClientHello message.
rule OTEE_Client_Hello [no_derivcheck]:
    let
      srv_pk = pk(~ltk)  // Prevent Tamarin from giving non-public key
                         // values to the O-TEE. The only use case of
                         // the key is to verify a signature from the
                         // server.
    in
    [ !OTEE($OTEE, $D)
    , In(<srv_pk>)
    , Fr(~u), Fr(~x_0), Fr(~tee_id) // The client nonce, client secret, and
                                    // the ID of the O-TEE thread
    ]
  --[ OTEEStartThread(~tee_id)
    , OTEEHello($OTEE, $D, ~u)
    , OTEEHelloDH($OTEE, $D, ~x_0, inv(~x_0), 'g'^~x_0)
    , ImpossibleBeforeXCH(~x_0)
    , ImpossibleBeforeXCH(inv(~x_0))
    , ImpossibleBeforeXCH('g'^~x_0)
    , OTEEHelloU($OTEE, ~u, inv(~u), 'g2'^~u)
    , ImpossibleBeforeUCH(~u)
    , ImpossibleBeforeUCH(inv(~u))
    , ImpossibleBeforeUCH('g2'^~u)
    , OTEESession($OTEE, ~u) ]->
    [ OTEE_0(~tee_id, $OTEE, 'g', 'g2', $D, ~u, 'g2'^~u, ~x_0, 'g'^~x_0, srv_pk)
    , Out(<'g2'^~u, 'g'^~x_0>)
    ]

// First message by the aggressor. This is the first and last message
// of a TLS server. The only difference is that the ServerHello.nonce
// is encoding a witness insteaed of being a random number.
rule Server_Hello [no_derivcheck]:
    let
      X_00 = 'g'^~x_0  // Verify the value is in the group and that it
                      // was generated from a fresh value. We assume
                      // this to simplify the proof for Tamarin. X_00
                      // is only used to derive the shared secret in
                      // TLS.

      // Compute the server's DH share and the shared secret DHE
      X_11 = 'g'^~x_1
      DHE = X_00^~x_1

      // Verify that the client nonce is a group element. In the ODT
      // protocol, the server would check this and, if client_nonce is
      // not a group element, behave as a normal TLS server. Since we
      // are using Tamarin to prove binding integrity and not
      // verification obliviousness, we model the server as if it only
      // accepts ODT verification.
      n_0 = 'g2'^CN

      // Calculate the expected witness, the interrupt indicator must
      // be '0'.
      w = calculate_witness('0', select(DHE), ~prop)
      // Set the server nonce to the homomorphically encrypted
      // witness.
      n_1 = calculate_server_nonce('g2', ~s, n_0, w)

      encrypted_server_certificate_ext = create_encrypted_server_certificate_ext_signed(n_0, X_00, n_1, X_11, ~ltk, DHE)
      encrypted_server_finished = create_encrypted_server_finished(n_0, X_00, n_1, X_11, ~ltk, DHE)
      expected_client_finished = calc_client_finished(n_0, X_00, n_1, X_11, pk(~ltk), DHE)

    in
    [ Aggressor_0($AGGR, ~prop, $A, ~ltk)
    , In( <n_0, X_00> )
    , Fr(~x_1)
    , Fr(~s)
    ]
    // Various sanity checks.
  --[ Neq(DHE, 'g')
    , Neq(DHE, DH_neutral)
    , Neq(X_00, 'g')
    , Neq(X_00, DH_neutral)
    , Neq(n_0, 'g2')
    , Neq(n_0, DH_neutral)
    , Neq(n_0^w, 'g2')
    , Neq(n_0^w, DH_neutral)
    , Neq(n_0, X_00)
    , Neq(n_0, DHE)
    , ServerHello($AGGR, $A)
    , OUT_Aggressor_0(~prop)
    , AggrDH($AGGR, X_00, ~x_1, 'g'^~x_1)
    , AggrDHKey($AGGR, DHE)
    , AggrS($AGGR, ~s)
    , AggrG2S($AGGR, 'g2'^~s)
    , AggrNonce($AGGR, n_1)
    , AggrServerHelloPK($AGGR, ~ltk, pk(~ltk))
    , AggrMeasurementSelection($AGGR, select(DHE))
    , AggrKeyUsedForEncryption($AGGR, server_handshake_traffic_secret(DHE))
    , AggrClientHandshakeKey(client_handshake_traffic_secret(DHE))
    ]->
    [ Aggressor_1($AGGR, 'g', 'g2', ~prop, ~s, $A, ~ltk, n_0, X_00, n_1, ~x_1, X_11, DHE)
    // According to the TLS specification, TLS messages are protected
    // with an AEAD algorithm that uses a key derived from the
    // server_handshake_traffic_secret. Instead, we use symmetric
    // encryption and do pattern matching during decryption to
    // approximate integrity protection as was done in the TLS 1.3
    // Tamarin model:
    // https://github.com/tls13tamarin/TLS13Tamarin/blob/67262370672b2cbcc461179e9d3e87eddcfcb999/src/rev21/model/record.m4i
    , Out( <n_1, X_11, encrypted_server_certificate_ext, encrypted_server_finished> )
    ]

// Perform the TLS client steps after receiving the TLS server's
// response and prepare for measurement.
rule OTEE_Receive_Server_Hello [no_derivcheck]:
    let
      X_11 = 'g'^~x_1 // Verify the server's DH share is in the
                     // appropriate group and was generated using a
                     // fresh value. We justify the assumption using
                     // the same argument as in the ServerHello rule.
      DHE = X_11^~x_0

      // Assumption: verify that e1 is fresh and that the server's
      // nonce is a group element generated with add. We introduce
      // this assumption to reduce the complexity of the
      // proof. Otherwise, it leads to a state explosion. We prove in
      // the paper that the server's nonce does not leak any
      // information to the adversary. In that sense, our model gives
      // the adversary more capabilities, but the adversary still
      // cannot attack our scheme.
      n_1 = add('g2'^~e1, 'g2'^e2)

      expected_server_certificate_verify_ext = server_certificate_verify_ext(n_0, X_00, n_1, X_11)
      expected_server_finished = server_finished(rec_server_certificate_verify_ext_signed, n_0, X_00, n_1, X_11, srv_pk, DHE)
    in
    [ OTEE_0(~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, srv_pk)
    , In(<n_1, X_11,
    // Assume the messages are well formed since TLS uses AEAD
    senc(rec_server_certificate_verify_ext_signed, server_handshake_traffic_secret(DHE)),
    senc(rec_server_finished, server_handshake_traffic_secret(DHE))>)
    ]
    // Verify the server's signature and the server's finished message.
  --[ Eq(verify(rec_server_certificate_verify_ext_signed, expected_server_certificate_verify_ext, srv_pk), true)
    , Eq(rec_server_finished, expected_server_finished)
    // Various sanity checks.
    , Neq(DHE, 'g'^1)
    , Neq(DHE, DH_neutral)
    , Neq(DHE, 'g'^~x_0)
    , Neq(DHE, 'g'^~x_1)
    , Neq(X_11, 'g2'^1)
    , Neq(X_11, DH_neutral)
    , Neq(X_11, 'g2'^~x_0)
    , Neq(('g2'^~e1)^e2, 'g2'^1)
    , Neq(('g2'^~e1)^e2, DH_neutral)
    , Neq(('g2'^~e1)^e2, 'g'^~x_0)
    , Neq(('g2'^~e1)^e2, 'g2'^~x_0)
    , Neq(('g2'^~e1)^e2, 'g2'^~u)
    , Neq(('g2'^~e1)^e2, ('g2'^~u)^~x_0)
    , Neq(('g2'^~e1)^e2, X_11^~u)
    , Neq(('g2'^~e1)^e2, DHE^~u)
    , Neq(('g2'^~e1)^e2, X_11)
    , Neq(('g2'^~e1)^e2, DHE)
    , Neq(('g2'^~e1)^e2, 'g2'^inv(~u))
    , Neq(('g2'^~e1)^e2, ('g2'^inv(~u))^~x_0)
    , Neq(('g2'^~e1)^e2, X_11^inv(~u))
    , Neq(('g2'^~e1)^e2, DHE^inv(~u))
    , OTEEExponents($OTEE, ~e1, e2)
    , OTEEReceiveServerHello($OTEE, srv_pk, n_1)
    , OTEEDHKey($OTEE, DHE)
    , OTEEDH($OTEE, ~x_0, inv(~x_0), X_11)
    , OTEESession($OTEE, ~u)
    , OTEESessionAggrNonce($OTEE, ~u, n_1)
    , PropertyHelper($OTEE, ~x_1, ~x_0, DHE)
    , OTEEServerHandshakeKey(client_handshake_traffic_secret(DHE))
    ]->
    [ OTEE_2(~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1, X_11, DHE, srv_pk) ]


// We assume that the measured positions leak after the
// measurement. Depending on the measurement mechanism and the
// hardware implementation this might not happen, but in our case we
// show that our protocol is secure even if the measurement locations are leaked to the adversary.
rule No_Interrupt_OTEE_Memory_Read:
    let
      ch_pos = select(DHE)
      ch_prop = ~prop
    in
    [ OTEE_2(~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1, X_11, DHE, srv_pk)
    // The $D in AgentInstance represents the assumption that the
    // agent process is on the system at the time of challenge for the
    // OTEE to measure the challenge property `ch_prop`.
    , !AgentInstance(~aid, $A, $D, ~prop) ]
  --[ OTEEHonestPropertyRead($OTEE, $D, $A, ~prop)
    , OTEESession($OTEE, ~u)
    , OTEESessionAggrNonce($OTEE, ~u, n_1)
    , OTEEPosition($OTEE, ch_pos)
    , OTEEMeasure($OTEE, ch_pos, ch_prop) ]->
    [ OTEE_3(~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1, X_11, DHE, srv_pk, ch_pos, ch_prop, '0')
    , Out(ch_pos) ]

// An adversary that knows the position the OTEE is going to read and
// the expected value can make the OTEE generate the correct response.
//
// Because the properties can come from anywhere and the adversary can
// only extract a subset of properties from an aggressor's agent, this
// covers the case where the adversary can copy a subset of memory
// locations from a distant system.
rule No_Interrupt_Prepared_Memory_Read:
    let
      ch_pos = select(DHE)
      ch_prop = ~adv_prop
    in
    [ OTEE_2(~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1, X_11, DHE, srv_pk)
    , In(~adv_prop) // Adversary provided properties
    ]
  --[ PreparedMemoryRead($OTEE, $D)
    , RequireOSCompromise($D)
    , OTEESession($OTEE, ~u)
    , OTEESessionAggrNonce($OTEE, ~u, n_1)
    , OTEEMeasure($OTEE, ch_pos, ch_prop) ]->
    [ OTEE_3(~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1, X_11, DHE, srv_pk, ch_pos, ch_prop, '0')
    , Out(ch_pos) ]


// Given control over the system, the adversary can interrupt the
// OTEE while it's running when it tries to read the challenge
// position.
rule Interrupt_OTEE_Memory_Read:
    let
      ch_pos = select(DHE)
    in
    [ OTEE_2(~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1, X_11, DHE, srv_pk) ]
  --[ RequireOSCompromise($D)
    , InterruptOTEEMemoryRead($OTEE, $D)
    , OTEESession($OTEE, ~u)
    , OTEESessionAggrNonce($OTEE, ~u, n_1)
    , OTEEMeasure($OTEE, ch_pos, 'null') ]->
    [ OTEE_Interrupt(~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1, X_11, DHE, srv_pk)
    , Out(ch_pos)  // Interrupting the OTEE allows the adversary to
                   // find out the measured positions.
    ]


// Note that the agent does not have to come from the same
// system. This models the adversary's ability to copy the whole agent
// process from one system to another. We assume it cannot do this
// without an interrupt because it would take too long.
rule Continue_OTEE_Interrupt_With_Agent:
    let
      ch_pos = select(DHE)
      ch_prop = ~prop
    in
    [ OTEE_Interrupt(~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1, X_11, DHE, srv_pk)
    , !AgentInstance(~aid, $A, $D2, ~prop) ]
  --[ ResumeOTEE($OTEE, $D)
    , RequireOSCompromise($D)
    , RequireOSCompromise($D2)
    , OTEESession($OTEE, ~u)
    , OTEESessionAggrNonce($OTEE, ~u, n_1)
    ]->
    [ OTEE_3(~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1, X_11, DHE, srv_pk, ch_pos, ch_prop, '1') ]


// Sends back the ClientFinished message and additionally the client
// response for the ODT protocol signed using the O-TEE's secret key.
rule OTEE_Challenge_Response:
    let
      // Calculate witness
      w = calculate_witness(int_indicator, ch_pos, ~ch_prop)
      // Compute client ODT response
      y = calculate_y('g2', ~t)
      z = calculate_z('g2', ~u, ~t, w, n_1)

      client_finished = calc_client_finished(n_0, X_00, n_1, X_11, srv_pk, DHE)

      // Sign client ODT response
      sig = sign(client_ODT_signature_payload(y, z, $OTEE, client_finished), ~OTEE_ltk)

    in
    [ OTEE_3(~tee_id, $OTEE, 'g', 'g2', $D, ~u, n_0, ~x_0, X_00, n_1, X_11, DHE, srv_pk, ch_pos, ~ch_prop, int_indicator)
    , !OTEE_Ltk($OTEE, ~OTEE_ltk)
    , Fr(~t) ]
    // Sanity checks
  --[ Neq(X_11, 'g')
    , Neq(X_11, DH_neutral)
    , Neq(z, 'g2')
    , Neq(z, DH_neutral)
    , Neq(z, 'g')
    , Neq(z, X_11)
    , Neq(z, 'g'^~x_0)
    , OTEEChallengeResponse($OTEE, $D, ~u)
    , OTEESession($OTEE, ~u)
    , OTEEWitness(w)
    , OTEEZ(z)
    , OTEESecret($OTEE, ~t, inv(~t), 'g2'^~t, 'g2'^inv(~t))
    , OTEEChallengeResponseDH($OTEE, ~x_0)
    , OTEEChallengeResponseKey($OTEE, DHE)
    , OTEESessionAggrNonce($OTEE, ~u, n_1)
    , OTEERevealSecretKey($OTEE, ~x_0) ]->
    [ Out(<'OTEE_challenge_response'
    , senc(client_finished, client_handshake_traffic_secret(DHE))
    , senc(client_ODT_response_payload(y, z, sig, $OTEE), client_application_traffic_secret(DHE))
    , ~x_0>) // Release the client secret to the adversary. We do this
             // to speed up the TLS connection. Even if the secret key
             // is leaked after the handshake, our protocol is secure.
    ]


rule Server_Finished [no_derivcheck]:
    let
      OTEE_pk = pk(~OTEE)  // Simplify proof for Tamarin by assuming
                           // that OTEE_pk can only be a public key.
                           // We immediatelly verify that OTEE_pk has
                           // a corresponding certificate from a
                           // neutral party.

      // Check that y and z are group elements. In practice, the
      // aggressor would simply reject the verification if it received
      // y and z that are not group elements. We therefore add this
      // additional restriction in our model so that there are less
      // states to explore.
      y = 'g2'^Y
      z = 'g2'^Z

    in
    [ Aggressor_1($AGGR, 'g', 'g2', ~prop, ~s, $A, ~ltk, n_0, X_00, n_1, ~x_1, X_11, DHE)
    // Assumption that the messages are well formed since TLS uses AEAD
    , In(<senc(client_finished, client_handshake_traffic_secret(DHE))
    , senc(client_ODT_response_payload(y, z, sig, $otee_id), client_application_traffic_secret(DHE))
    , OTEE_pk
    , NP_OTEE_signature>)
    // Assume the aggressor knows public key of NP
    , !NP_Pk($NP, NP_pk)
    ]
    // Sanity checks
  --[ Neq(y, 'g2')
    , Neq(y, DH_neutral)
    , Neq(y, n_1)
    , Neq(y, z)
    , Neq(z, 'g2')
    , Neq(z, DH_neutral)
    , Neq(z, n_1)
    , Eq(verify(NP_OTEE_signature, <$otee_id, OTEE_pk>, NP_pk), true)
    , Eq(client_finished, calc_client_finished(n_0, X_00, n_1, X_11, pk(~ltk), DHE))
    , Eq(z, y^~s)
    , Eq(verify(sig, client_ODT_signature_payload(y, z, $otee_id, client_finished), OTEE_pk), true)
    , AcceptVerificationWithAgent($AGGR, $otee_id, $A, ~prop)
    , AcceptVerification($AGGR, $otee_id)
    , AcceptVerificationDHE($AGGR, DHE)
    , AcceptVerificationPosition($AGGR, select(DHE)) ]->
    [ Aggressor_Done($AGGR) ]


// Restrictions on the proof process.

restriction Equality:
    "All x y #i. Eq(x,y) @i ==> x = y"

restriction Inequality:
    "All x #i. Neq(x,x) @ #i ==> F"

restriction Unique:
    "All x #i #j. Unique(x) @i & Unique(x) @j ==> #i = #j"

restriction OnlyOneNP:
    "All x y #i #j. InitializeNP(x) @i & InitializeNP(y) @j ==> #i = #j"

restriction OnlyOneAggressor:
    "All AGGR AGGR2 #i #j. AggressorInitialized(AGGR) @i & AggressorInitialized(AGGR2) @j ==> #i = #j"

restriction AdversaryDoesNotExtractPropertiesFromOwnAgents:
    "All A prop #i #j. AdversaryExtractAgentProperties(A, prop) @i & AdversaryCreateAgent(A, prop) @j ==> F"

restriction OTEESessionCannotInterleaveWithSameNonce:
    "All OTEE u n1 #i #j.
    OTEESessionAggrNonce(OTEE, u, n1) @i &
    OTEESessionAggrNonce(OTEE, u, n1) @j
    ==> (All u_2 #k. OTEESessionAggrNonce(OTEE, u_2, n1) @k & i < k & k < j & not (u = u_2) ==> F)"

restriction OTEESessionHasToFinishBeforeStartingNext:
    "All OTEE u u_2 n_1 #i #j.
    OTEESessionAggrNonce(OTEE, u, n_1) @i & OTEESessionAggrNonce(OTEE, u_2, n_1) @j & i < j & not (u = u_2)
    ==> (Ex C #k. OTEEChallengeResponse(OTEE, C, u) @k & i < k & k < j)"


// The lemmas we prove for our protocol. The relevant ones for the
// paper is the `auto_binding_integrity`. The others are auxiliary
// lemmas that Tamarin can use to speed up the proof of the main
// lemma.

lemma auto_adversaryCannotCompromiseNPLTK [reuse]:
    "(All NP ltk #i #j.
    InitializeNP_LTK(NP, ltk) @i & KU(ltk) @j
    ==> F
    )"

lemma auto_adversaryCannotKnowAggressorLtk [reuse]:
    "All AGGR ltk pk_ltk #i #j.
    AggrServerHelloPK(AGGR, ltk, pk_ltk) @i &
    KU(ltk) @j
    ==> F
    "

lemma auto_adversaryCannotRecoverAggressorDHShare [reuse]:
    "(All AGGR x_0 x_1 X_11 #i #j.
    AggrDH(AGGR, x_0, x_1, X_11) @i & KU(x_1) @j
    ==> F
    )"

lemma auto_adversaryCannotFindPropertiesFromAggressor [reuse]:
    "
    (All OTEE ch_pos ch_prop A #i #j #k.
    OTEEMeasure(OTEE, ch_pos, ch_prop) @i & OUT_Aggressor_0(ch_prop) @j & AdversaryCreateAgent(A, ch_prop) @k ==> F)
    "

lemma auto_aggressorDHKeyIsUnique [reuse]:
    "All AGGR AGGR2 DHE #i #j.
    AggrDHKey(AGGR, DHE) @i &
    AggrDHKey(AGGR2, DHE) @j & not (AGGR = AGGR2)
    ==> F"

lemma auto_adversaryCannotLearnOTEELtk [reuse]:
    "All NP OTEE OTEE_ltk #i #j.
    OTEERegisterOTEE(NP, OTEE, OTEE_ltk) @i &
    KU(OTEE_ltk) @j
    ==> F"

lemma auto_OTEEOrder [reuse]:
    "
    (
    All OTEE x_0 u pk_ltk n_1 #i #j.
    OTEEChallengeResponseDH(OTEE, x_0) @i & OTEESession(OTEE, u) @i & OTEEReceiveServerHello(OTEE, pk_ltk, n_1) @j & OTEESession(OTEE, u) @j & #i < #j ==> F
    )
    "

lemma auto_adversaryCannotKnowEnclaveShareBeforeReveal [reuse]:
    "All OTEE key #i #j.
    OTEERevealSecretKey(OTEE, key) @i &
    KU(key) @j & #j < #i
    ==> F
    "

lemma auto_adversaryKnowsOTEEDHSecretAfterReveal [reuse]:
    "(All OTEE D x_0 x_0_inv X_00 u #i #j.
    OTEEHelloDH(OTEE, D, x_0, x_0_inv, X_00) @i &
    OTEESession(OTEE, u) @i &
    KU(x_0) @j
    ==> (Ex #k. OTEEChallengeResponseDH(OTEE, x_0) @k & OTEESession(OTEE, u) @k & #k < #j)
    )"


lemma auto_adversaryCannotLearnDeviceDHShareBeforeEnd [reuse]:
    "
    (All OTEE D x_0 x_0_inv X_00 #i #j.
    OTEEHelloDH(OTEE, D, x_0, x_0_inv, X_00) @i & KU(x_0) @j ==> (Ex x_0_inv X_11 #k. OTEEDH(OTEE, x_0, x_0_inv, X_11) @k & (#k < #j)))
    "

lemma auto_ifOTEEConnectsToServerThenShareMustBeOutputByTheServer [reuse]:
    "
    (All OTEE AGGR_pk n_1 x_0 x_0_inv X_11 AGGR #i #j.
    OTEEReceiveServerHello(OTEE, AGGR_pk, n_1) @i & OTEEDH(OTEE, x_0, x_0_inv, X_11) @i & AggressorPK(AGGR, AGGR_pk) @j ==> (Ex X_00 x_1 #k. AggrDH(AGGR, X_00, x_1, X_11) @k)
    )
    "

lemma auto_OTEEServerNonceSource [reuse]:
    "
    All OTEE u n_1 #i.
    OTEESessionAggrNonce(OTEE, u, n_1) @i
    ==> ((Ex AGGR #j. AggrNonce(AGGR, n_1) @j) |
    (Ex #j. KU(n_1) @j))
    "

lemma auto_ifServerAndOTEEDeriveSameKeyTheAdversaryCannotLearnIt [reuse]:
    "All AGGR OTEE DHE #i #j #k.
    AggrDHKey(AGGR, DHE) @i & OTEEDHKey(OTEE, DHE) @j & KU(DHE) @k & #k < #j
    ==> F
    "

lemma auto_ifServerAndOTEEDeriveSameKeyTheAdversaryCannotLearnServerHandshakeSecret [reuse]:
    "All AGGR OTEE DHE key #i #j #k.
    AggrDHKey(AGGR, DHE) @i & OTEEDHKey(OTEE, DHE) @j & OTEEServerHandshakeKey(key) @j & KU(key) @k & #k < #j
    ==> F
    "

lemma auto_ifServerAndOTEEDeriveSameKeyTheAdversaryCannotLearnClientHandshakeSecret [reuse]:
    "All AGGR OTEE DHE key #i #j #k.
    AggrDHKey(AGGR, DHE) @i & AggrClientHandshakeKey(key) @i & OTEEDHKey(OTEE, DHE) @j & KU(key) @k & #k < #i
    ==> F
    "

lemma auto_twoOTEEsCannotHaveSameDHE [reuse]:
    "
    (All OTEE OTEE2 DHE #i #j.
    OTEEDHKey(OTEE, DHE) @i & OTEEDHKey(OTEE2, DHE) @j & (not #i = #j) ==> F)
    "

lemma auto_twoAggrCannotHaveSameDHE [reuse]:
    "
    (All AGGR AGGR2 DHE #i #j.
    AggrDHKey(AGGR, DHE) @i & AggrDHKey(AGGR2, DHE) @j & (not #i = #j) ==> F)
    "

lemma auto_ifServerAndOTEEHaveSameKeyThenTheyCommunicated [reuse]:
    "
    (All OTEE DHE AGGR ltk pk_ltk #i #j.
    OTEEDHKey(OTEE, DHE) @i & AggrDHKey(AGGR, DHE) @j & AggrServerHelloPK(AGGR, ltk, pk_ltk) @j ==> (Ex n_1. OTEEReceiveServerHello(OTEE, pk_ltk, n_1) @i)
    )
    "

lemma auto_adversaryCannotKnowDHEBeforeReveal [reuse]:
    "All OTEE key DHE AGGR #i #k #l.
    OTEERevealSecretKey(OTEE, key) @i &
    OTEEChallengeResponseKey(OTEE, DHE) @i &
    AggrDHKey(AGGR, DHE) @k &
    KU(DHE) @l & #l < #i
    ==> F
    "

lemma auto_AdversaryNeverLearnsT [reuse]:
    "
    All OTEE t invT g2_t g2_inv_t #i #j.
    OTEESecret(OTEE, t, invT, g2_t, g2_inv_t) @i & KU(t) @j
    ==> F
    "

lemma auto_AdversaryNeverLearnsInvT [reuse]:
    "
    All OTEE t invT g2_t g2_inv_t #i #j.
    OTEESecret(OTEE, t, invT, g2_t, g2_inv_t) @i & KU(invT) @j
    ==> F
    "

lemma auto_AdversaryNeverLearnsS [reuse]:
    "
    All AGGR s #i #j.
    AggrS(AGGR, s) @i & KU(s) @j
    ==> F
    "

lemma auto_OTEEExponentsLemma [reuse]:
    "
    All OTEE e1 e2 DHE AGGR #i #j #k.
    OTEEExponents(OTEE, e1, e2) @i & OTEEDHKey(OTEE, DHE) @i & AggrS(AGGR, e1) @j & AggrDHKey(AGGR, DHE) @j & KU(e2) @k
    ==> F
    "

lemma auto_AdversaryNeverLearnsG2TBeforeT [reuse]:
    "
    All OTEE t invT g2_t g2_inv_t #i #j.
    OTEESecret(OTEE, t, invT, g2_t, g2_inv_t) @i & KU(g2_t) @j & #j < #i
    ==> F
    "

lemma auto_AdversaryNeverLearnsG2InvTBeforeT [reuse]:
    "
    All OTEE t invT g2_t g2_inv_t #i #j.
    OTEESecret(OTEE, t, invT, g2_t, g2_inv_t) @i & KU(g2_inv_t) @j & #j < #i
    ==> F
    "

lemma auto_ImpossibleBeforeXCH [reuse]:
    "
    All x #i #j.
    ImpossibleBeforeXCH(x) @i & KU(x) @j & #j < #i
    ==> F
    "

lemma auto_ImpossibleBeforeUCH [reuse]:
    "
    All u #i #j.
    ImpossibleBeforeUCH(u) @i & KU(u) @j & #j < #i
    ==> F
    "

lemma auto_adversaryCannotKnowMeasurementPositionBeforeMeasurement [reuse]:
    "
    (All OTEE ch_pos ch_prop AGGR #i #j.
    OTEEMeasure(OTEE, ch_pos, ch_prop) @i & AggrMeasurementSelection(AGGR, ch_pos) @j ==> (not (Ex #k. KU(ch_pos) @k & #k < #i))
    )
    "

lemma auto_token_integrity [reuse]:
    "All AGGR OTEE #i.
    AcceptVerification(AGGR, OTEE) @i
    ==>
    (Ex D NP #j. OTEERegisteredOnDevice(NP, OTEE, D) @j & j < i)
    "

lemma auto_measurementPositionIsUnique [reuse]:
    "All OTEE OTEE2 pos #i #j.
    OTEEPosition(OTEE, pos) @i &
    OTEEPosition(OTEE2, pos) @j & not (#i = #j)
    ==> F
    "

lemma auto_succeessfultVerificationImpliesEnclaveMeasuredCorrectProperties [reuse]:
    "All AGGR OTEE A prop pos #i #j.
    AcceptVerificationWithAgent(AGGR, OTEE, A, prop) @i &
    AcceptVerificationPosition(AGGR, pos) @i &
    OTEEPosition(OTEE, pos) @j
    ==> Ex D. OTEEHonestPropertyRead(OTEE, D, A, prop) @j"


lemma auto_binding_integrity:
    "All AGGR OTEE A prop #i.
    AcceptVerificationWithAgent(AGGR, OTEE, A, prop) @i
    ==>
    (
    (Ex NP D DHE #j #k #l #m #n.
    OTEERegisteredOnDevice(NP, OTEE, D) @j
    & OTEEHonestPropertyRead(OTEE, D, A, prop) @k
    & AggressorCreateAgent(AGGR, A, prop) @l
    & AggrDHKey(AGGR, DHE) @m
    & OTEEDHKey(OTEE, DHE) @n)
    )
    "

// Proves that the protocol can be executed correctly.

lemma executable:
    exists-trace
    "Ex AGGR OTEE A prop NP #i #j.
    AcceptVerificationWithAgent(AGGR, OTEE, A, prop) @i
    & InitializeNP(NP) @j
    & (All NP2 #j2. InitializeNP(NP2) @j2 ==> #j = #j2) "

end
